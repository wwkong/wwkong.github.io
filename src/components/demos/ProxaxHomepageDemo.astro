    const objectiveRows = {
      rosenbrock: document.getElementById('home-obj-rosen'),
      quadratic: document.getElementById('home-obj-quad'),
      himmelblau: document.getElementById('home-obj-himm'),
      lasso: document.getElementById('home-obj-lasso'),
      box_qp: document.getElementById('home-obj-box'),
      chained_rosen: document.getElementById('home-obj-chained'),
      sparse_lasso: document.getElementById('home-obj-sparse'),
      simplex_qp: document.getElementById('home-obj-simplex'),
      nuc_norm: document.getElementById('home-obj-nuc'),
      group_lasso: document.getElementById('home-obj-group'),
      sparse_logreg: document.getElementById('home-obj-logreg'),
      spec_quad: document.getElementById('home-obj-spec'),
    };
    const noteRows = {
      rosenbrock: document.getElementById('home-note-rosen'),
      quadratic: document.getElementById('home-note-quad'),
      himmelblau: document.getElementById('home-note-himm'),
      lasso: document.getElementById('home-note-lasso'),
      box_qp: document.getElementById('home-note-box'),
      chained_rosen: document.getElementById('home-note-chained'),
      sparse_lasso: document.getElementById('home-note-sparse'),
      simplex_qp: document.getElementById('home-note-simplex'),
      nuc_norm: document.getElementById('home-note-nuc'),
      group_lasso: document.getElementById('home-note-group'),
      sparse_logreg: document.getElementById('home-note-logreg'),
      spec_quad: document.getElementById('home-note-spec'),
    };
    const contourTitles = {
      rosenbrock: document.getElementById('home-contour-title-rosen'),
      quadratic: document.getElementById('home-contour-title-quad'),
      himmelblau: document.getElementById('home-contour-title-himm'),
      lasso: document.getElementById('home-contour-title-lasso'),
      box_qp: document.getElementById('home-contour-title-box'),
      chained_rosen: document.getElementById('home-contour-title-chained'),
      sparse_lasso: document.getElementById('home-contour-title-sparse'),
      simplex_qp: document.getElementById('home-contour-title-simplex'),
      nuc_norm: document.getElementById('home-contour-title-nuc'),
      group_lasso: document.getElementById('home-contour-title-group'),
      sparse_logreg: document.getElementById('home-contour-title-logreg'),
      spec_quad: document.getElementById('home-contour-title-spec'),
    };
    const curveTitles = {
      obj: document.getElementById('home-curve-title-obj'),
      grad: document.getElementById('home-curve-title-grad'),
      dist: document.getElementById('home-curve-title-dist'),
    };
    const paramVal = document.getElementById('home-param-val');
    const iterSlider = document.getElementById('home-iter-slider');
    const iterVal = document.getElementById('home-iter-val');
    const animStepInput = document.getElementById('home-anim-step');
    const animFpsSlider = document.getElementById('home-anim-fps');
    const animFpsVal = document.getElementById('home-anim-fps-val');
    const resetBtn = document.getElementById('home-demo-reset');
    const playBtn = document.getElementById('home-demo-play');
    const shareBtn = document.getElementById('home-demo-share');
    const shareLabel = document.getElementById('home-demo-share-label');
    const xAxisBtns = Array.from(document.querySelectorAll('.home-xaxis-btn'));
    const xAxisProxBtn = document.getElementById('home-xaxis-prox');
    const xAxisLabels = [
      document.getElementById('home-xaxis-label-obj'),
      document.getElementById('home-xaxis-label-grad'),
      document.getElementById('home-xaxis-label-dist'),
    ];
    const gapBadge = document.getElementById('home-demo-gap');
    const readoutEl = document.getElementById('home-demo-readout');
    const lbfgsBtn = document.getElementById('home-method-lbfgs');
    const lbfgsNote = document.getElementById('lbfgs-smooth-note');
    const zoomToolbar = document.getElementById('home-zoom-toolbar');
    const zoomAutoBtn = document.getElementById('home-zoom-auto');
    const zoomLevelEl = document.getElementById('home-zoom-level');
    const zoomInBtn = document.getElementById('home-zoom-in');
    const zoomOutBtn = document.getElementById('home-zoom-out');
    const zoomResetBtn = document.getElementById('home-zoom-reset');
    const contourCanvas = document.getElementById('home-contour-canvas');
    const curveCanvas = document.getElementById('home-curve-canvas');
    const curveTooltip = document.getElementById('home-curve-tooltip');
    const probBtns = Array.from(document.querySelectorAll('.home-prob-btn'));
    const metricBtns = Array.from(document.querySelectorAll('.home-metric-btn'));
    const methodBtns = Array.from(document.querySelectorAll('.home-method-btn'));

    if (!contourCanvas || !curveCanvas) return;
    const cCtx = contourCanvas.getContext('2d');
    const gCtx = curveCanvas.getContext('2d');

    let problem = 'rosenbrock';
    let metric = 'obj';
    let xAxisMode = 'grad';
    const visibleMethods = {
      gd: true,
      agd: true,
      nag: true,
      anag: true,
      apd: true,
      adam: true,
      lbfgs: true,
    };
    let animId = null;
    let cachedBgKey = '';
    let cachedBgImg = null;
    let simCacheKey = '';
    let simCache = null;
    let viewBox = null;
    let autoZoom = false;
    let isDragging = false;
    let dragStart = null;
    let hoverK = null;

    const isHighDim = (p) =>
      p === 'chained_rosen' ||
      p === 'sparse_lasso' ||
      p === 'simplex_qp' ||
      p === 'nuc_norm' ||
      p === 'group_lasso' ||
      p === 'sparse_logreg' ||
      p === 'spec_quad';
    const isComposite = (p) =>
      p === 'lasso' ||
      p === 'box_qp' ||
      p === 'sparse_lasso' ||
      p === 'simplex_qp' ||
      p === 'nuc_norm' ||
      p === 'group_lasso' ||
      p === 'sparse_logreg';

    // ---- Precomputed deterministic data ----
    // 1. 2D Composite L1 rotated quadratic
    const thL1 = (28 * Math.PI) / 180;
    const cL1 = Math.cos(thL1),
      sL1 = Math.sin(thL1);
    const q00 = cL1 * cL1 * 1.0 + sL1 * sL1 * 80.0;
    const q01 = cL1 * sL1 * (1.0 - 80.0);
    const q11 = sL1 * sL1 * 1.0 + cL1 * cL1 * 80.0;
    const cVecL1 = [2.4, -0.3];

    // 2. Himmelblau 4 optima
    const himmOptima = [
      [3.0, 2.0],
      [-2.805118086952745, 3.131312518250573],
      [-3.779310253377747, -3.28318599128617],
      [3.584428340330492, -1.848126526964404],
    ];

    // 3. Deterministic 48 x 64 Gaussian matrix A & sparse true signal for Sparse Lasso (64D)
    const SPARSE_M = 48;
    const SPARSE_D = 64;
    const sparseA = new Array(SPARSE_M);
    const sparseTrue = new Array(SPARSE_D).fill(0);
    {
      let seed = 1337;
      const rand = () => {
        seed = (seed * 1664525 + 1013904223) >>> 0;
        return seed / 4294967296;
      };
      const randn = () => {
        const u1 = Math.max(1e-9, rand());
        const u2 = rand();
        return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
      };
      const scale = 1.0 / Math.sqrt(SPARSE_M);
      for (let i = 0; i < SPARSE_M; i++) {
        const row = new Float64Array(SPARSE_D);
        for (let j = 0; j < SPARSE_D; j++) row[j] = randn() * scale;
        sparseA[i] = row;
      }
      const spikes = [
        [5, 0.85],
        [14, -0.7],
        [23, 0.95],
        [31, -0.65],
        [40, 0.8],
        [49, -0.9],
        [56, 0.68],
        [61, -0.75],
      ];
      spikes.forEach(([idx, val]) => {
        sparseTrue[idx] = val;
      });
    }
    const sparseY = new Float64Array(SPARSE_M);
    for (let i = 0; i < SPARSE_M; i++) {
      let sum = 0;
      const row = sparseA[i];
      for (let j = 0; j < SPARSE_D; j++) sum += row[j] * sparseTrue[j];
      sparseY[i] = sum;
    }

    // 4. Deterministic 48 x 64 problem data for Simplex QP (64D)
    const SIMPLEX_M = 48;
    const SIMPLEX_D = 64;
    const simplexA = new Array(SIMPLEX_M);
    const simplexTrue = new Array(SIMPLEX_D).fill(0);
