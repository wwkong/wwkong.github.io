          }
          let n2 = 0;
          for (let j = 0; j < d; j++) n2 += x[j] * x[j];
          return 0.5 * s + 0.5 * param * n2;
        };
        const gr = (x) => {
          const res = new Float64Array(SIMPLEX_M);
          for (let i = 0; i < SIMPLEX_M; i++) {
            const row = simplexA[i];
            let r = -simplexB[i];
            for (let j = 0; j < d; j++) r += row[j] * x[j];
            res[i] = r;
          }
          const g = new Array(d);
          for (let j = 0; j < d; j++) g[j] = param * x[j];
          for (let i = 0; i < SIMPLEX_M; i++) {
            const row = simplexA[i];
            const ri = res[i];
            for (let j = 0; j < d; j++) g[j] += row[j] * ri;
          }
          return g;
        };
        return {
          dim: d,
          maxK: 600,
          x0,
          optima: null,
          fStar: 0,
          eta: 1.0 / (6.0 + param),
          etaNag: 1.0 / (6.0 + param),
          adamLr: 0.03,
          lbfgsMem: 5,
          Linit: 4.0 + param,
          fSmooth: fS,
          fTotal: fS,
          grad: gr,
          prox: (x) => projSimplex(x),
          Lref: 6.0 + param,
          lam: 0,
          lbfgsMode: 'softmax',
        };
      }
      if (prob === 'nuc_norm') {
        const d = NUC_D;
        const x0 = new Array(d).fill(0);
        const fS = (x) => {
          let s = 0;
          for (let i = 0; i < d; i++) {
            if (nucMask[i]) {
              const e = x[i] - nucTrue[i];
              s += e * e;
            }
          }
          return 0.5 * s;
        };
        const gr = (x) => {
          const g = new Array(d);
          for (let i = 0; i < d; i++) g[i] = nucMask[i] ? x[i] - nucTrue[i] : 0;
          return g;
        };
        const fT = (x) => {
          const { w } = jacobiEig8(x);
          let nuc = 0;
          for (let i = 0; i < NUC_N; i++) nuc += Math.abs(w[i]);
          return fS(x) + param * nuc;
        };
        const prox = (x, L) => {
          const { w, V } = jacobiEig8(x);
          const a = param / L;
          const ws = new Float64Array(NUC_N);
          for (let i = 0; i < NUC_N; i++) {
            const v = w[i];
            ws[i] = v > a ? v - a : v < -a ? v + a : 0;
          }
          return reconstructSym8(V, ws);
        };
        return {
          dim: d,
          maxK: 400,
          x0,
          optima: null,
          fStar: 0,
          eta: 0.9,
          etaNag: 0.9,
          adamLr: 0.08,
          lbfgsMem: 5,
          Linit: 1.5,
          fSmooth: fS,
          fTotal: fT,
          grad: gr,
          prox,
          Lref: 1.0,
          lam: param,
          lbfgsMode: 'nuc_smooth',
        };
      }
      if (prob === 'group_lasso') {
        const d = GROUP_D;
        const x0 = new Array(d).fill(0);
        const fS = (x) => {
          let s = 0;
          for (let i = 0; i < GROUP_M; i++) {
            const row = groupA[i];
            let r = -groupY[i];
            for (let j = 0; j < d; j++) r += row[j] * x[j];
            s += r * r;
          }
          return 0.5 * s;
        };
        const fT = (x) => {
          let gn = 0;
          for (let g = 0; g < GROUP_G; g++) {
            let n2 = 0;
            const off = g * GROUP_SZ;
            for (let j = 0; j < GROUP_SZ; j++) n2 += x[off + j] * x[off + j];
            gn += Math.sqrt(n2);
          }
          return fS(x) + param * gn;
        };
        const gr = (x) => {
          const res = new Float64Array(GROUP_M);
          for (let i = 0; i < GROUP_M; i++) {
            const row = groupA[i];
            let r = -groupY[i];
            for (let j = 0; j < d; j++) r += row[j] * x[j];
            res[i] = r;
          }
          const g = new Array(d).fill(0);
          for (let i = 0; i < GROUP_M; i++) {
            const row = groupA[i];
            const ri = res[i];
            for (let j = 0; j < d; j++) g[j] += row[j] * ri;
          }
          return g;
        };
        const prox = (x, L) => {
          const a = param / L;
          const out = new Array(d);
          for (let g = 0; g < GROUP_G; g++) {
            const off = g * GROUP_SZ;
            let n2 = 0;
            for (let j = 0; j < GROUP_SZ; j++) n2 += x[off + j] * x[off + j];
            const nrm = Math.sqrt(n2);
            const sc = nrm > a ? 1.0 - a / nrm : 0.0;
            for (let j = 0; j < GROUP_SZ; j++) out[off + j] = x[off + j] * sc;
          }
          return out;
        };
        return {
          dim: d,
          maxK: 600,
          x0,
          optima: null,
          fStar: 0,
          eta: 1.0 / 6.0,
          etaNag: 1.0 / 6.0,
          adamLr: 0.03,
          lbfgsMem: 5,
          Linit: 4.0,
          fSmooth: fS,
          fTotal: fT,
          grad: gr,
          prox,
          Lref: 6.0,
          lam: param,
          lbfgsMode: 'group_smooth',
        };
      }
      if (prob === 'sparse_logreg') {
        const d = LR_D;
        const x0 = new Array(d).fill(0);
        const fS = (x) => {
          let s = 0;
          for (let i = 0; i < LR_N; i++) {
            const row = lrA[i];
            let dot = 0;
            for (let j = 0; j < d; j++) dot += row[j] * x[j];
            const z = lrY[i] * dot;
            s += z > 20 ? Math.exp(-z) : z < -20 ? -z : Math.log(1.0 + Math.exp(-z));
          }
          return s / LR_N;
        };
        const fT = (x) => {
          let l1 = 0;
          for (let j = 0; j < d; j++) l1 += Math.abs(x[j]);
          return fS(x) + param * l1;
        };
        const gr = (x) => {
          const g = new Array(d).fill(0);
          for (let i = 0; i < LR_N; i++) {
            const row = lrA[i];
            let dot = 0;
            for (let j = 0; j < d; j++) dot += row[j] * x[j];
            const z = lrY[i] * dot;
            const p = z > 30 ? 0 : z < -30 ? 1 : 1.0 / (1.0 + Math.exp(z));
            const coeff = (-lrY[i] * p) / LR_N;
            for (let j = 0; j < d; j++) g[j] += coeff * row[j];
          }
          return g;
        };
        const prox = (x, L) => {
          const a = param / L;
          const out = new Array(d);
          for (let j = 0; j < d; j++) {
            const v = x[j];
            out[j] = v > a ? v - a : v < -a ? v + a : 0;
          }
          return out;
        };
        return {
          dim: d,
          maxK: 600,
          x0,
          optima: null,
          fStar: 0,
          eta: 1.5,
          etaNag: 1.5,
          adamLr: 0.05,
          lbfgsMem: 5,
          Linit: 0.6,
          fSmooth: fS,
          fTotal: fT,
          grad: gr,
          prox,
          Lref: 0.6,
          lam: param,
          lbfgsMode: 'huber',
        };
      }
      // spec_quad: d = 100, dense rotated quadratic Q Λ Q^T with log-spaced eigenvalues [1, kappa]
      const d = SPEC_D;
      const eigs = Array.from({ length: d }, (_, i) => Math.pow(param, i / (d - 1)));
      const opt = Array.from({ length: d }, (_, i) => 0.5 * Math.sin(0.25 * (i + 1)) + (i % 2 === 0 ? 0.25 : -0.25));
      const x0 = new Array(d).fill(0);
      const diffBuf = new Float64Array(d);
      const evalQuad = (x) => {
        for (let i = 0; i < d; i++) diffBuf[i] = x[i] - opt[i];
        const z = applySpecQT(diffBuf);
        let s = 0;
        for (let i = 0; i < d; i++) s += eigs[i] * z[i] * z[i];
        return 0.5 * s;
      };
      return {
        dim: d,
        maxK: 800,
        eigs,
        x0,
        optima: [opt],
        fStar: 0,
        eta: 1.0 / param,
        etaNag: 1.0 / param,
        adamLr: 0.02,
        lbfgsMem: 5,
        Linit: param * 0.5,
        fSmooth: evalQuad,
        fTotal: evalQuad,
        grad: (x) => {
          for (let i = 0; i < d; i++) diffBuf[i] = x[i] - opt[i];
          const z = applySpecQT(diffBuf);
          for (let i = 0; i < d; i++) z[i] *= eigs[i];
          return applySpecQ(z);
        },
        prox: null,
        Lref: 1,
      };
    }

    function vecNorm(v) {
      let s = 0;
      for (let i = 0; i < v.length; i++) s += v[i] * v[i];
      return Math.sqrt(s);
    }

    function vecDist(a, b) {
      let s = 0;
      for (let i = 0; i < a.length; i++) {
        const d = a[i] - b[i];
        s += d * d;
      }
      return Math.sqrt(s);
    }

    function runFullSim(probName, param) {
      const key = `${probName}:${param}`;
      if (simCacheKey === key && simCache) return simCache;

      const P = buildProblem(probName, param);
      const d = P.dim;
      const K = P.maxK;
      const x0 = P.x0;
      const applyProx = (v, L) => (P.prox ? P.prox(v, L) : v);

      // Helper to run Proxax APD (1 grad eval/step; 1 + backtracking trials prox evals/step)
      function runApd(steps) {
        const traj = [x0.slice()];
        const proxEv = new Uint32Array(steps + 1);
        let xp = x0.slice();
        let y = x0.slice();
        let t = 1.0;
        let L = P.Linit;
        let cumProx = 0;
        for (let k = 0; k < steps; k++) {
          const fy = P.fSmooth(y);
          const gy = P.grad(y);
          L = Math.max(0.5, L * 0.85);
          let xn = y;
          for (let tries = 0; tries < 35; tries++) {
            const cand = new Array(d);
            for (let i = 0; i < d; i++) cand[i] = y[i] - gy[i] / L;
            xn = applyProx(cand, L);
            if (P.prox) cumProx += 1;
            let dot = 0,
              sq = 0;
            for (let i = 0; i < d; i++) {
              const dx = xn[i] - y[i];
              dot += gy[i] * dx;
              sq += dx * dx;
            }
            if (P.fSmooth(xn) <= fy + dot + 0.5 * L * sq + 1e-13 || L > 1e8) break;
            L *= 2.0;
          }
          let rdot = 0;
          for (let i = 0; i < d; i++) rdot += (y[i] - xn[i]) * (xn[i] - xp[i]);
          if (rdot > 0) {
            t = 1.0;
            y = xn.slice();
          } else {
            const tn = 0.5 * (1.0 + Math.sqrt(1.0 + 4.0 * t * t));
            const beta = (t - 1.0) / tn;
            const yn = new Array(d);
            for (let i = 0; i < d; i++) yn[i] = xn[i] + beta * (xn[i] - xp[i]);
            y = yn;
            t = tn;
          }
          xp = xn;
          traj.push(xn);
          proxEv[k + 1] = cumProx;
        }
        return { traj, proxEv };
      }

      // 5. Proxax APD (also used as exact reference optimum for composite problems!)
      const apdRes = runApd(K);
      const apd = apdRes.traj;
      const proxApd = apdRes.proxEv;
      let optima = P.optima;
      let fStar = P.fStar;
      if (!optima) {
        // Refine reference solution for composite problems
        const refTraj = runApd(Math.max(K, 900)).traj;
        const xRef = refTraj[refTraj.length - 1];
        optima = [xRef];
        fStar = P.fTotal(xRef);
      }

      // 1. Classic GD / PG (conservative Lipschitz estimate L_hat = 2 * L => eta = 1 / (2L))
      const etaGd = 0.5 * P.eta;
      const gd = [x0.slice()];
      const evLin = new Uint32Array(K + 1);
      const proxLin = new Uint32Array(K + 1);
      for (let k = 0; k < K; k++) {
        const x = gd[k];
        const g = P.grad(x);
        const cand = new Array(d);
        for (let i = 0; i < d; i++) cand[i] = x[i] - etaGd * g[i];
        gd.push(applyProx(cand, 1.0 / etaGd));
        evLin[k + 1] = k + 1;
        proxLin[k + 1] = P.prox ? k + 1 : 0;
      }

      // 2. Backtracking GD / PG
      const agd = [x0.slice()];
      const proxAgd = new Uint32Array(K + 1);
      let L1 = P.Linit;
      let cumProxAgd = 0;
      for (let k = 0; k < K; k++) {
        const x = agd[k];
        const fx = P.fSmooth(x);
        const g = P.grad(x);
        L1 = Math.max(0.5, L1 * 0.7);
        let xn = x;
        for (let tries = 0; tries < 35; tries++) {
          const cand = new Array(d);
          for (let i = 0; i < d; i++) cand[i] = x[i] - g[i] / L1;
          xn = applyProx(cand, L1);
          if (P.prox) cumProxAgd += 1;
          let dot = 0,
            sq = 0;
          for (let i = 0; i < d; i++) {
            const dx = xn[i] - x[i];
            dot += g[i] * dx;
            sq += dx * dx;
          }
          if (P.fSmooth(xn) <= fx + dot + 0.5 * L1 * sq + 1e-13 || L1 > 1e8) break;
          L1 *= 2.0;
        }
        agd.push(xn);
        proxAgd[k + 1] = cumProxAgd;
      }

      // 3. Classic Nesterov AGD / FISTA (conservative Lipschitz estimate L_hat = 2 * L => eta = 1 / (2L))
      const etaNag = 0.5 * P.etaNag;
      const nag = [x0.slice()];
      let xNagPrev = x0.slice();
      let yNag = x0.slice();
      let tNag = 1.0;
      for (let k = 0; k < K; k++) {
        const g = P.grad(yNag);
        const cand = new Array(d);
        for (let i = 0; i < d; i++) cand[i] = yNag[i] - etaNag * g[i];
        const xn = applyProx(cand, 1.0 / etaNag);
        const tn = 0.5 * (1.0 + Math.sqrt(1.0 + 4.0 * tNag * tNag));
        const beta = (tNag - 1.0) / tn;
        const yn = new Array(d);
        for (let i = 0; i < d; i++) yn[i] = xn[i] + beta * (xn[i] - xNagPrev[i]);
        xNagPrev = xn;
        yNag = yn;
        tNag = tn;
        nag.push(xn);
      }

      // 4. Adaptive Nesterov (no restart)
      const anag = [x0.slice()];
      const proxAnag = new Uint32Array(K + 1);
      let xAnagPrev = x0.slice();
      let yAnag = x0.slice();
      let tAnag = 1.0;
      let LAnag = P.Linit;
      let cumProxAnag = 0;
      for (let k = 0; k < K; k++) {
        const fy = P.fSmooth(yAnag);
        const gy = P.grad(yAnag);
        LAnag = Math.max(0.5, LAnag * 0.85);
        let xn = yAnag;
        for (let tries = 0; tries < 35; tries++) {
          const cand = new Array(d);
          for (let i = 0; i < d; i++) cand[i] = yAnag[i] - gy[i] / LAnag;
          xn = applyProx(cand, LAnag);
          if (P.prox) cumProxAnag += 1;
          let dot = 0,
            sq = 0;
          for (let i = 0; i < d; i++) {
            const dx = xn[i] - yAnag[i];
            dot += gy[i] * dx;
            sq += dx * dx;
          }
          if (P.fSmooth(xn) <= fy + dot + 0.5 * LAnag * sq + 1e-13 || LAnag > 1e8) break;
          LAnag *= 2.0;
        }
        const tn = 0.5 * (1.0 + Math.sqrt(1.0 + 4.0 * tAnag * tAnag));
        const beta = (tAnag - 1.0) / tn;
        const yn = new Array(d);
        for (let i = 0; i < d; i++) yn[i] = xn[i] + beta * (xn[i] - xAnagPrev[i]);
        xAnagPrev = xn;
        yAnag = yn;
        tAnag = tn;
        anag.push(xn);
        proxAnag[k + 1] = cumProxAnag;
      }

      // 6. Adam
      const adam = [x0.slice()];
      const m = new Float64Array(d);
      const v = new Float64Array(d);
      let b1p = 1,
        b2p = 1;
      for (let k = 1; k <= K; k++) {
        const x = adam[k - 1];
        const g = P.grad(x);
        b1p *= 0.9;
        b2p *= 0.999;
        const inv1 = 1.0 / (1.0 - b1p);
        const inv2 = 1.0 / (1.0 - b2p);
        const cand = new Array(d);
        for (let i = 0; i < d; i++) {
          m[i] = 0.9 * m[i] + 0.1 * g[i];
          v[i] = 0.999 * v[i] + 0.001 * g[i] * g[i];
          cand[i] = x[i] - (P.adamLr * m[i] * inv1) / (Math.sqrt(v[i] * inv2) + 1e-8);
        }
        adam.push(P.prox ? P.prox(cand, 1.0 / P.adamLr) : cand);
      }

      // 7. L-BFGS (exact on smooth; smoothed/reparameterized on nonsmooth/constrained problems)
      const lbfgs = [x0.slice()];
      const gradLbfgs = new Uint32Array(K + 1);
      const proxLbfgs = new Uint32Array(K + 1);
      {
        let cumGradLb = 0;
        const mode = P.lbfgsMode || (P.prox ? 'huber' : 'smooth');
        const eps = mode === 'nuc_smooth' ? 1e-3 : 1e-4;
        const eps2 = eps * eps;
        const mapToX =
          mode === 'softmax'
            ? (z) => softmaxVec(z)
            : mode === 'tanh'
              ? (z) => z.map((v) => Math.tanh(v))
              : (z) => z;
        let fLbfgs = P.fSmooth;
        let gLbfgs = P.grad;
        if (mode === 'softmax') {
          fLbfgs = (z) => P.fSmooth(softmaxVec(z));
          gLbfgs = (z) => {
            const sm = softmaxVec(z);
            const gx = P.grad(sm);
            let dot = 0;
            for (let i = 0; i < d; i++) dot += sm[i] * gx[i];
            const gz = new Array(d);
            for (let i = 0; i < d; i++) gz[i] = sm[i] * (gx[i] - dot);
            return gz;
          };
        } else if (mode === 'tanh') {
          fLbfgs = (z) => P.fSmooth(z.map((v) => Math.tanh(v)));
          gLbfgs = (z) => {
            const x = z.map((v) => Math.tanh(v));
            const gx = P.grad(x);
            return gx.map((g, i) => g * (1.0 - x[i] * x[i]));
          };
        } else if (mode === 'huber') {
          fLbfgs = (x) => {
            let h = 0;
            for (let i = 0; i < d; i++) h += Math.sqrt(x[i] * x[i] + eps2) - eps;
            return P.fSmooth(x) + P.lam * h;
          };
          gLbfgs = (x) => {
            const g = P.grad(x);
            for (let i = 0; i < d; i++) g[i] += (P.lam * x[i]) / Math.sqrt(x[i] * x[i] + eps2);
            return g;
          };
        } else if (mode === 'group_smooth') {
          fLbfgs = (x) => {
            let h = 0;
            for (let gIdx = 0; gIdx < GROUP_G; gIdx++) {
              let n2 = 0;
              const off = gIdx * GROUP_SZ;
              for (let j = 0; j < GROUP_SZ; j++) n2 += x[off + j] * x[off + j];
              h += Math.sqrt(n2 + eps2) - eps;
            }
            return P.fSmooth(x) + P.lam * h;
          };
          gLbfgs = (x) => {
            const g = P.grad(x);
            for (let gIdx = 0; gIdx < GROUP_G; gIdx++) {
              let n2 = 0;
              const off = gIdx * GROUP_SZ;
              for (let j = 0; j < GROUP_SZ; j++) n2 += x[off + j] * x[off + j];
              const denom = Math.sqrt(n2 + eps2);
              for (let j = 0; j < GROUP_SZ; j++) g[off + j] += (P.lam * x[off + j]) / denom;
            }
            return g;
          };
        } else if (mode === 'nuc_smooth') {
          fLbfgs = (x) => {
            const { w } = jacobiEig8(x);
            let h = 0;
            for (let i = 0; i < NUC_N; i++) h += Math.sqrt(w[i] * w[i] + eps2) - eps;
            return P.fSmooth(x) + P.lam * h;
          };
          gLbfgs = (x) => {
            const g = P.grad(x);
            const { w, V } = jacobiEig8(x);
            const wg = new Float64Array(NUC_N);
            for (let i = 0; i < NUC_N; i++) wg[i] = w[i] / Math.sqrt(w[i] * w[i] + eps2);
            const sg = reconstructSym8(V, wg);
            for (let i = 0; i < d; i++) g[i] += P.lam * sg[i];
            return g;
          };
        }
        const S = [],
          Y = [];
        let x =
          mode === 'softmax'
            ? new Array(d).fill(0)
            : mode === 'tanh'
              ? x0.map((v) => Math.atanh(Math.max(-0.99, Math.min(0.99, v))))
              : x0.slice();
        let converged = false;
        let gCur = gLbfgs(x);
        cumGradLb += 1;
        for (let k = 0; k < K; k++) {
          if (converged) {
            lbfgs.push(mapToX(x));
            gradLbfgs[k + 1] = cumGradLb;
            continue;
          }
          const g = gCur;
          const gn = vecNorm(g);
          if (gn < 1e-12) {
            converged = true;
            lbfgs.push(mapToX(x));
            gradLbfgs[k + 1] = cumGradLb;
            continue;
          }
          const q = g.slice();
          const alphas = new Array(S.length);
          const rhos = new Array(S.length);
          for (let j = S.length - 1; j >= 0; j--) {
            let sy = 0,
              sq = 0;
            const sj = S[j],
              yj = Y[j];
            for (let i = 0; i < d; i++) {
              sy += sj[i] * yj[i];
              sq += sj[i] * q[i];
            }
            const rho = 1.0 / sy;
            rhos[j] = rho;
            const a = rho * sq;
            alphas[j] = a;
            for (let i = 0; i < d; i++) q[i] -= a * yj[i];
          }
          let gamma = 1.0 / Math.max(gn, 1.0);
          if (S.length > 0) {
            const ls = S[S.length - 1],
              ly = Y[Y.length - 1];
            let sy = 0,
              yy = 0;
            for (let i = 0; i < d; i++) {
              sy += ls[i] * ly[i];
              yy += ly[i] * ly[i];
            }
            gamma = sy / Math.max(yy, 1e-30);
          }
          const r = new Array(d);
          for (let i = 0; i < d; i++) r[i] = gamma * q[i];
          for (let j = 0; j < S.length; j++) {
            const sj = S[j],
              yj = Y[j];
            let yr = 0;
            for (let i = 0; i < d; i++) yr += yj[i] * r[i];
            const b = rhos[j] * yr;
            const diff = alphas[j] - b;
            for (let i = 0; i < d; i++) r[i] += sj[i] * diff;
          }
          let dg = 0;
          const dir = new Array(d);
          for (let i = 0; i < d; i++) {
            dir[i] = -r[i];
            dg += dir[i] * g[i];
          }
          if (dg >= 0 || !Number.isFinite(dg)) {
            dg = 0;
            for (let i = 0; i < d; i++) {
              dir[i] = -g[i];
              dg -= g[i] * g[i];
            }
          }
          const fx = fLbfgs(x);
          let step = 1.0;
          let xn = x;
          for (let tries = 0; tries < 25; tries++) {
            const cand = new Array(d);
            for (let i = 0; i < d; i++) cand[i] = x[i] + step * dir[i];
            xn = cand;
            if (fLbfgs(xn) <= fx + 1e-4 * step * dg) break;
            step *= 0.5;
          }
          const gnVec = gLbfgs(xn);
          cumGradLb += 1;
          const sv = new Array(d),
            yv = new Array(d);
          let sy = 0,
            sn = 0,
            yn = 0;
          for (let i = 0; i < d; i++) {
            sv[i] = xn[i] - x[i];
            yv[i] = gnVec[i] - g[i];
            sy += sv[i] * yv[i];
            sn += sv[i] * sv[i];
            yn += yv[i] * yv[i];
          }
          if (sy > 1e-12 * Math.sqrt(sn * yn)) {
            S.push(sv);
            Y.push(yv);
            if (S.length > P.lbfgsMem) {
              S.shift();
              Y.shift();
            }
          }
          x = xn;
          gCur = gnVec;
          lbfgs.push(mapToX(x));
          gradLbfgs[k + 1] = cumGradLb;
        }
      }

      // Precompute all 3 metrics across all iterations for instant O(1) rendering!
      function computeMetrics(traj) {
        const n = traj.length;
        const obj = new Float64Array(n);
        const grad = new Float64Array(n);
        const dist = new Float64Array(n);
        for (let k = 0; k < n; k++) {
          const pt = traj[k];
          obj[k] = Math.max(0, P.fTotal(pt) - fStar);
          const g = P.grad(pt);
          if (P.prox) {
            const cand = new Array(d);
            for (let i = 0; i < d; i++) cand[i] = pt[i] - g[i] / P.Lref;
            const xp = P.prox(cand, P.Lref);
            grad[k] = P.Lref * vecDist(pt, xp);
          } else {
            grad[k] = vecNorm(g);
          }
          let bestD = Infinity;
          for (let o = 0; o < optima.length; o++) {
            const dd = vecDist(pt, optima[o]);
            if (dd < bestD) bestD = dd;
          }
          dist[k] = bestD;
        }
        return { obj, grad, dist };
      }

      simCacheKey = key;
      simCache = {
        P,
        optima,
        fStar,
        trajs: { gd, agd, nag, anag, apd, adam, lbfgs },
        gradEvals: { gd: evLin, agd: evLin, nag: evLin, anag: evLin, apd: evLin, adam: evLin, lbfgs: gradLbfgs },
        proxEvals: { gd: proxLin, agd: proxAgd, nag: proxLin, anag: proxAnag, apd: proxApd, adam: proxLin, lbfgs: proxLbfgs },
        metrics: {
          gd: computeMetrics(gd),
          agd: computeMetrics(agd),
          nag: computeMetrics(nag),
          anag: computeMetrics(anag),
          apd: computeMetrics(apd),
          adam: computeMetrics(adam),
          lbfgs: computeMetrics(lbfgs),
        },
      };
      return simCache;
    }

    function get2DBounds(param) {
      if (problem === 'rosenbrock')
        return { xMin: -1.65, xMax: 1.55, yMin: -0.4, yMax: 1.8, x0: [-1.2, 1.0] };
      if (problem === 'quadratic')
        return { xMin: -2.4, xMax: 1.2, yMin: -1.1, yMax: 1.1, x0: [-2.1, 0.85] };
      if (problem === 'himmelblau') {
        const rad = (param * Math.PI) / 180;
        return { xMin: -5.0, xMax: 5.0, yMin: -5.0, yMax: 5.0, x0: [1.5 * Math.cos(rad), 1.5 * Math.sin(rad)] };
      }
      if (problem === 'box_qp')
        return { xMin: -1.35, xMax: 1.35, yMin: -1.35, yMax: 1.35, x0: [0.06, -0.04] };
      return { xMin: -2.2, xMax: 2.2, yMin: -1.4, yMax: 1.8, x0: [-1.8, 1.4] };
    }

    function getViewBounds(param) {
      const base = get2DBounds(param);
      return viewBox ? { ...base, ...viewBox } : base;
    }

    function renderHeatmapBg(W, H, param, P, fStar, isDark) {
      const bgParam = problem === 'himmelblau' ? 0 : param;
      const vb = getViewBounds(param);
      const vbKey = `${vb.xMin.toFixed(4)},${vb.xMax.toFixed(4)},${vb.yMin.toFixed(4)},${vb.yMax.toFixed(4)}`;
      const key = `${problem}:${bgParam}:${isDark ? 'd' : 'l'}:${vbKey}`;
      if (cachedBgKey === key && cachedBgImg) return cachedBgImg;

      const { xMin, xMax, yMin, yMax } = vb;
      const img = cCtx.createImageData(W, H);
      const data = img.data;

      for (let py = 0; py < H; py++) {
        const wy = yMax - (py / (H - 1)) * (yMax - yMin);
        for (let px = 0; px < W; px++) {
          const wx = xMin + (px / (W - 1)) * (xMax - xMin);
          const v = Math.max(0, P.fTotal([wx, wy]) - fStar);
          const lv = Math.log10(v + 1e-3);
          const norm = Math.max(0, Math.min(1, (lv + 2.5) / 5.5));
          const ring = Math.abs((((lv * 2.2) % 1) + 1) % 1 - 0.5) < 0.045;
          const idx = (py * W + px) * 4;
          if (isDark) {
            let r = 10 + norm * 16,
              g = 46 - norm * 22,
              b = 33 - norm * 12;
            if (ring) {
              r += 16;
              g += 28;
              b += 20;
            }
            data[idx] = r;
            data[idx + 1] = g;
            data[idx + 2] = b;
            data[idx + 3] = 255;
          } else {
            let r = 205 + norm * 45,
              g = 242 + norm * 10,
              b = 221 + norm * 28;
            if (ring) {
              r -= 24;
              g -= 18;
              b -= 22;
            }
            data[idx] = r;
            data[idx + 1] = g;
            data[idx + 2] = b;
            data[idx + 3] = 255;
          }
        }
      }
      cachedBgKey = key;
      cachedBgImg = img;
      return img;
    }

    function drawHighDimLeft(sim, K, isDark, gridColor, axisColor, textColor, lbfgsColor) {
      const W = contourCanvas.width;
      const H = contourCanvas.height;
      cCtx.clearRect(0, 0, W, H);
      const pad = { l: 46, r: 16, t: 18, b: 30 };
      const plotW = W - pad.l - pad.r;
      const plotH = H - pad.t - pad.b;
      const { P, optima, trajs } = sim;
      const d = P.dim;
      const lbfgsActive = visibleMethods.lbfgs;

      cCtx.font = '10px JetBrains Mono, monospace';
      cCtx.fillStyle = textColor;

      if (problem === 'chained_rosen') {
        // Coordinate profile x_i vs i = 1..50 (target = 1.0)
        const yMin = -1.35,
          yMax = 1.35;
        const sx = (i) => pad.l + (i / (d - 1)) * plotW;
        const sy = (v) => pad.t + ((yMax - Math.max(yMin, Math.min(yMax, v))) / (yMax - yMin)) * plotH;

        [-1, 0, 1].forEach((val) => {
          const y = sy(val);
          cCtx.strokeStyle = val === 1 ? (isDark ? 'rgba(52,211,153,0.45)' : 'rgba(21,128,61,0.4)') : gridColor;
          cCtx.setLineDash(val === 1 ? [5, 4] : []);
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.setLineDash([]);
          cCtx.fillText(val === 1 ? 'x*=1' : String(val), 6, y + 3);
        });

        const drawProfile = (vec, color, width, dashed) => {
          cCtx.strokeStyle = color;
          cCtx.lineWidth = width;
          cCtx.setLineDash(dashed ? [6, 3] : []);
          cCtx.beginPath();
          for (let i = 0; i < d; i++) {
            const px = sx(i),
              py = sy(vec[i]);
            if (i === 0) cCtx.moveTo(px, py);
            else cCtx.lineTo(px, py);
          }
          cCtx.stroke();
          cCtx.setLineDash([]);
        };

        if (visibleMethods.gd) drawProfile(trajs.gd[K], '#ef4444', 1.7, false);
        if (visibleMethods.agd) drawProfile(trajs.agd[K], '#f59e0b', 1.7, false);
        if (visibleMethods.nag) drawProfile(trajs.nag[K], '#8b5cf6', 1.7, false);
        if (visibleMethods.anag) drawProfile(trajs.anag[K], '#0ea5e9', 1.7, false);
        if (visibleMethods.adam) drawProfile(trajs.adam[K], '#f472b6', 1.7, false);
        if (visibleMethods.apd) drawProfile(trajs.apd[K], '#10b981', 2.4, false);
        if (lbfgsActive) drawProfile(trajs.lbfgs[K], lbfgsColor, 1.9, true);

        cCtx.fillText('coord i = 1', pad.l, H - 10);
        cCtx.fillText(`i = ${d}`, W - pad.r - 36, H - 10);
      } else if (problem === 'sparse_lasso') {
        // Log-scale magnitude plot: log10|x_i| from 10^0 (1.0) down to 10^-8
        const minLog = -8,
          maxLog = 0;
        const sx = (i) => pad.l + ((i + 0.5) / d) * plotW;
        const sy = (val) => {
          const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(Math.abs(val), 1e-12))));
          return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
        };
        const yFloor = sy(1e-8);

        for (let p = minLog; p <= maxLog; p += 2) {
          const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
          cCtx.strokeStyle = p === minLog ? axisColor : gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(p === 0 ? '1.0' : `10^${p}`, 4, y + 3);
        }

        // True spikes background stems
        for (let i = 0; i < d; i++) {
          if (sparseTrue[i] !== 0) {
            const px = sx(i),
              py = sy(sparseTrue[i]);
            cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.22)';
            cCtx.lineWidth = 5;
            cCtx.beginPath();
            cCtx.moveTo(px, yFloor);
            cCtx.lineTo(px, py);
            cCtx.stroke();
          }
        }

        const drawDots = (vec, color, r) => {
          cCtx.fillStyle = color;
          for (let i = 0; i < d; i++) {
            cCtx.beginPath();
            cCtx.arc(sx(i), sy(vec[i]), r, 0, Math.PI * 2);
            cCtx.fill();
          }
        };

        if (visibleMethods.apd) {
          const vec = trajs.apd[K];
          cCtx.strokeStyle = '#10b981';
          cCtx.lineWidth = 1.8;
          for (let i = 0; i < d; i++) {
            if (Math.abs(vec[i]) > 1e-8) {
              cCtx.beginPath();
              cCtx.moveTo(sx(i), yFloor);
              cCtx.lineTo(sx(i), sy(vec[i]));
              cCtx.stroke();
            }
          }
          drawDots(vec, '#10b981', 3.0);
        }
        if (visibleMethods.gd) drawDots(trajs.gd[K], '#ef4444', 2.1);
        if (visibleMethods.agd) drawDots(trajs.agd[K], '#f59e0b', 2.1);
        if (visibleMethods.nag) drawDots(trajs.nag[K], '#8b5cf6', 2.1);
        if (visibleMethods.anag) drawDots(trajs.anag[K], '#0ea5e9', 2.1);
        if (visibleMethods.adam) drawDots(trajs.adam[K], '#f472b6', 2.1);
        if (visibleMethods.lbfgs) drawDots(trajs.lbfgs[K], lbfgsColor, 2.1);

        cCtx.fillStyle = textColor;
        cCtx.fillText('log₁₀|xᵢ| · gray bars = true spikes · i = 1..64', pad.l, H - 10);
      } else if (problem === 'simplex_qp') {
        // Simplex weights x_i in [0, 0.32] across i = 1..64
        const yMin = 0,
          yMax = 0.3;
        const sx = (i) => pad.l + ((i + 0.5) / d) * plotW;
        const sy = (v) => pad.t + ((yMax - Math.max(yMin, Math.min(yMax, v))) / (yMax - yMin)) * plotH;
        const y0 = sy(0);

        [0, 0.1, 0.2, 0.3].forEach((val) => {
          const y = sy(val);
          cCtx.strokeStyle = val === 0 ? axisColor : gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(val.toFixed(1), 10, y + 3);
        });

        // True sparse portfolio weights background bars
        for (let i = 0; i < d; i++) {
          if (simplexTrue[i] > 0) {
            const px = sx(i),
              py = sy(simplexTrue[i]);
            cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.22)';
            cCtx.lineWidth = 5;
            cCtx.beginPath();
            cCtx.moveTo(px, y0);
            cCtx.lineTo(px, py);
            cCtx.stroke();
          }
        }

        const drawWeightDots = (vec, color, r) => {
          cCtx.fillStyle = color;
          for (let i = 0; i < d; i++) {
            if (vec[i] > 0.004 || simplexTrue[i] > 0) {
              cCtx.beginPath();
              cCtx.arc(sx(i), sy(vec[i]), r, 0, Math.PI * 2);
              cCtx.fill();
            }
          }
        };

        if (visibleMethods.apd) {
          const vec = trajs.apd[K];
          cCtx.strokeStyle = '#10b981';
          cCtx.lineWidth = 2;
          for (let i = 0; i < d; i++) {
            if (vec[i] > 0.004) {
              cCtx.beginPath();
              cCtx.moveTo(sx(i), y0);
              cCtx.lineTo(sx(i), sy(vec[i]));
              cCtx.stroke();
            }
          }
          drawWeightDots(vec, '#10b981', 3.2);
        }
        if (visibleMethods.gd) drawWeightDots(trajs.gd[K], '#ef4444', 2.3);
        if (visibleMethods.agd) drawWeightDots(trajs.agd[K], '#f59e0b', 2.3);
        if (visibleMethods.nag) drawWeightDots(trajs.nag[K], '#8b5cf6', 2.3);
        if (visibleMethods.anag) drawWeightDots(trajs.anag[K], '#0ea5e9', 2.3);
        if (visibleMethods.adam) drawWeightDots(trajs.adam[K], '#f472b6', 2.3);
        if (visibleMethods.lbfgs) drawWeightDots(trajs.lbfgs[K], lbfgsColor, 2.2);

        cCtx.fillStyle = textColor;
        cCtx.fillText('gray bars = true weights · Σxᵢ = 1, xᵢ ≥ 0', pad.l, H - 10);
      } else if (problem === 'nuc_norm') {
        // Log-scale singular values |sigma_1| >= ... >= |sigma_8| from 10^1.5 down to 10^-8
        const minLog = -8,
          maxLog = 2;
        const sx = (i) => pad.l + ((i + 0.5) / NUC_N) * plotW;
        const sy = (val) => {
          const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(Math.abs(val), 1e-12))));
          return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
        };
        const yFloor = sy(1e-8);

        for (let p = minLog; p <= maxLog; p += 2) {
          const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
          cCtx.strokeStyle = p === minLog ? axisColor : gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(p === 0 ? '1.0' : `10^${p}`, 4, y + 3);
        }

        // True rank-2 singular values bars
        for (let i = 0; i < NUC_N; i++) {
          if (nucTrueSigs[i] > 1e-6) {
            const px = sx(i),
              py = sy(nucTrueSigs[i]);
            cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.22)';
            cCtx.lineWidth = 10;
            cCtx.beginPath();
            cCtx.moveTo(px, yFloor);
            cCtx.lineTo(px, py);
            cCtx.stroke();
          }
        }

        const getSigs = (vec) => Array.from(jacobiEig8(vec).w, (v) => Math.abs(v)).sort((a, b) => b - a);
        const drawSigs = (vec, color, width, dashed) => {
          const sigs = getSigs(vec);
          cCtx.strokeStyle = color;
          cCtx.lineWidth = width;
          cCtx.setLineDash(dashed ? [5, 3] : []);
          cCtx.beginPath();
          for (let i = 0; i < NUC_N; i++) {
            const px = sx(i),
              py = sy(sigs[i]);
            if (i === 0) cCtx.moveTo(px, py);
            else cCtx.lineTo(px, py);
          }
          cCtx.stroke();
          cCtx.setLineDash([]);
          cCtx.fillStyle = color;
          for (let i = 0; i < NUC_N; i++) {
            cCtx.beginPath();
            cCtx.arc(sx(i), sy(sigs[i]), 3.0, 0, Math.PI * 2);
            cCtx.fill();
          }
        };

        if (visibleMethods.gd) drawSigs(trajs.gd[K], '#ef4444', 1.6, false);
        if (visibleMethods.agd) drawSigs(trajs.agd[K], '#f59e0b', 1.6, false);
        if (visibleMethods.nag) drawSigs(trajs.nag[K], '#8b5cf6', 1.6, false);
        if (visibleMethods.anag) drawSigs(trajs.anag[K], '#0ea5e9', 1.6, false);
        if (visibleMethods.adam) drawSigs(trajs.adam[K], '#f472b6', 1.6, false);
        if (visibleMethods.apd) drawSigs(trajs.apd[K], '#10b981', 2.4, false);
        if (visibleMethods.lbfgs) drawSigs(trajs.lbfgs[K], lbfgsColor, 1.8, true);

        cCtx.fillStyle = textColor;
        cCtx.fillText('log₁₀ σᵢ(X) · gray bars = true rank-2 spectrum · i = 1..8', pad.l, H - 10);
      } else if (problem === 'group_lasso') {
        // Log-scale group norms ||x_g||_2 from 1.0 down to 10^-8 across g = 1..8
        const minLog = -8,
          maxLog = 0;
        const sx = (g) => pad.l + ((g + 0.5) / GROUP_G) * plotW;
        const sy = (val) => {
          const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(val, 1e-12))));
          return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
        };
        const yFloor = sy(1e-8);

        for (let p = minLog; p <= maxLog; p += 2) {
          const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
          cCtx.strokeStyle = p === minLog ? axisColor : gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(p === 0 ? '1.0' : `10^${p}`, 4, y + 3);
        }

        for (let g = 0; g < GROUP_G; g++) {
          if (groupTrueNorms[g] > 0) {
            const px = sx(g),
              py = sy(groupTrueNorms[g]);
            cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.22)';
            cCtx.lineWidth = 14;
            cCtx.beginPath();
            cCtx.moveTo(px, yFloor);
            cCtx.lineTo(px, py);
            cCtx.stroke();
          }
        }

        const groupNorms = (vec) =>
          Array.from({ length: GROUP_G }, (_, g) => {
            let n2 = 0;
            const off = g * GROUP_SZ;
            for (let j = 0; j < GROUP_SZ; j++) n2 += vec[off + j] * vec[off + j];
            return Math.sqrt(n2);
          });
        const drawGrpDots = (vec, color, r, xOff) => {
          const gn = groupNorms(vec);
          cCtx.fillStyle = color;
          for (let g = 0; g < GROUP_G; g++) {
            cCtx.beginPath();
            cCtx.arc(sx(g) + xOff, sy(gn[g]), r, 0, Math.PI * 2);
            cCtx.fill();
          }
        };

        if (visibleMethods.apd) {
          const gn = groupNorms(trajs.apd[K]);
          cCtx.strokeStyle = '#10b981';
          cCtx.lineWidth = 3;
          for (let g = 0; g < GROUP_G; g++) {
            if (gn[g] > 1e-8) {
              cCtx.beginPath();
              cCtx.moveTo(sx(g), yFloor);
              cCtx.lineTo(sx(g), sy(gn[g]));
              cCtx.stroke();
            }
          }
          drawGrpDots(trajs.apd[K], '#10b981', 3.6, 0);
        }
        if (visibleMethods.gd) drawGrpDots(trajs.gd[K], '#ef4444', 2.8, -10);
        if (visibleMethods.agd) drawGrpDots(trajs.agd[K], '#f59e0b', 2.8, -6);
        if (visibleMethods.nag) drawGrpDots(trajs.nag[K], '#8b5cf6', 2.8, -3);
        if (visibleMethods.anag) drawGrpDots(trajs.anag[K], '#0ea5e9', 2.8, 3);
        if (visibleMethods.adam) drawGrpDots(trajs.adam[K], '#f472b6', 2.8, 6);
        if (visibleMethods.lbfgs) drawGrpDots(trajs.lbfgs[K], lbfgsColor, 3.0, 10);

        cCtx.fillStyle = textColor;
        cCtx.fillText('log₁₀‖x_g‖₂ · gray bars = true active groups · g = 1..8', pad.l, H - 10);
      } else if (problem === 'sparse_logreg') {
        // Log-scale feature magnitudes |x_i| from 1.0 down to 10^-8 across i = 1..64
        const minLog = -8,
          maxLog = 0;
        const sx = (i) => pad.l + ((i + 0.5) / d) * plotW;
        const sy = (val) => {
          const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(Math.abs(val), 1e-12))));
          return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
        };
        const yFloor = sy(1e-8);

        for (let p = minLog; p <= maxLog; p += 2) {
          const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
          cCtx.strokeStyle = p === minLog ? axisColor : gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(p === 0 ? '1.0' : `10^${p}`, 4, y + 3);
        }

        for (let i = 0; i < d; i++) {
          if (lrTrue[i] !== 0) {
            const px = sx(i),
              py = sy(lrTrue[i]);
            cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.22)';
            cCtx.lineWidth = 5;
            cCtx.beginPath();
            cCtx.moveTo(px, yFloor);
            cCtx.lineTo(px, py);
            cCtx.stroke();
          }
        }

        const drawDots = (vec, color, r) => {
          cCtx.fillStyle = color;
          for (let i = 0; i < d; i++) {
            cCtx.beginPath();
            cCtx.arc(sx(i), sy(vec[i]), r, 0, Math.PI * 2);
            cCtx.fill();
          }
        };

        if (visibleMethods.apd) {
          const vec = trajs.apd[K];
          cCtx.strokeStyle = '#10b981';
          cCtx.lineWidth = 1.8;
          for (let i = 0; i < d; i++) {
            if (Math.abs(vec[i]) > 1e-8) {
              cCtx.beginPath();
              cCtx.moveTo(sx(i), yFloor);
              cCtx.lineTo(sx(i), sy(vec[i]));
              cCtx.stroke();
            }
          }
          drawDots(vec, '#10b981', 3.0);
        }
        if (visibleMethods.gd) drawDots(trajs.gd[K], '#ef4444', 2.1);
        if (visibleMethods.agd) drawDots(trajs.agd[K], '#f59e0b', 2.1);
        if (visibleMethods.nag) drawDots(trajs.nag[K], '#8b5cf6', 2.1);
        if (visibleMethods.anag) drawDots(trajs.anag[K], '#0ea5e9', 2.1);
        if (visibleMethods.adam) drawDots(trajs.adam[K], '#f472b6', 2.1);
        if (visibleMethods.lbfgs) drawDots(trajs.lbfgs[K], lbfgsColor, 2.1);

        cCtx.fillStyle = textColor;
        cCtx.fillText('log₁₀|xᵢ| · gray bars = true features · i = 1..64', pad.l, H - 10);
      } else {
        // spec_quad: per-eigenmode log10|x_i - x*_i| across i = 1..100
        const opt = optima[0];
        const minLog = -12,
          maxLog = 1;
        const sx = (i) => pad.l + (i / (d - 1)) * plotW;
        const sy = (val) => {
          const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(Math.abs(val), 1e-14))));
          return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
        };

        for (let p = minLog; p <= maxLog; p += 3) {
          const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
          cCtx.strokeStyle = gridColor;
          cCtx.beginPath();
          cCtx.moveTo(pad.l, y);
          cCtx.lineTo(W - pad.r, y);
          cCtx.stroke();
          cCtx.fillText(`10^${p}`, 4, y + 3);
        }

        const drawSpec = (vec, color, width, dashed) => {
          const diff = new Float64Array(d);
          for (let i = 0; i < d; i++) diff[i] = vec[i] - opt[i];
          const z = applySpecQT(diff);
          cCtx.strokeStyle = color;
          cCtx.lineWidth = width;
          cCtx.setLineDash(dashed ? [6, 3] : []);
          cCtx.beginPath();
          for (let i = 0; i < d; i++) {
            const px = sx(i),
              py = sy(z[i]);
            if (i === 0) cCtx.moveTo(px, py);
            else cCtx.lineTo(px, py);
          }
          cCtx.stroke();
          cCtx.setLineDash([]);
        };

        if (visibleMethods.gd) drawSpec(trajs.gd[K], '#ef4444', 1.8, false);
        if (visibleMethods.agd) drawSpec(trajs.agd[K], '#f59e0b', 1.8, false);
        if (visibleMethods.nag) drawSpec(trajs.nag[K], '#8b5cf6', 1.8, false);
        if (visibleMethods.anag) drawSpec(trajs.anag[K], '#0ea5e9', 1.8, false);
        if (visibleMethods.adam) drawSpec(trajs.adam[K], '#f472b6', 1.8, false);
        if (visibleMethods.apd) drawSpec(trajs.apd[K], '#10b981', 2.4, false);
        if (lbfgsActive) drawSpec(trajs.lbfgs[K], lbfgsColor, 1.9, true);

        cCtx.fillText('λ₁ = 1 (slow)', pad.l, H - 10);
        cCtx.fillText('λ₁₀₀ = κ (fast)', W - pad.r - 88, H - 10);
      }

      // Outer axes
      cCtx.strokeStyle = axisColor;
      cCtx.lineWidth = 1;
      cCtx.beginPath();
      cCtx.moveTo(pad.l, pad.t);
      cCtx.lineTo(pad.l, H - pad.b);
      cCtx.lineTo(W - pad.r, H - pad.b);
      cCtx.stroke();
    }

    function draw() {
      const param = Number(paramSlider.value);
      const K = Number(iterSlider.value);
      paramVal.textContent =
        problem === 'sparse_logreg'
          ? param.toFixed(3)
          : problem === 'simplex_qp' || problem === 'sparse_lasso' || problem === 'nuc_norm' || problem === 'group_lasso'
            ? param.toFixed(2)
            : problem === 'lasso'
              ? param.toFixed(1)
              : String(param);
      iterVal.textContent = String(K);

      const isDark = document.documentElement.classList.contains('dark');
      const gridColor = isDark ? 'rgba(147,175,160,0.18)' : 'rgba(75,95,82,0.16)';
      const axisColor = isDark ? 'rgba(147,175,160,0.45)' : 'rgba(75,95,82,0.45)';
      const textColor = isDark ? '#93afa0' : '#4b5f52';
      const lbfgsColor = isDark ? '#f8fafc' : '#0f172a';

      const sim = runFullSim(problem, param);
      const { P, optima, fStar, trajs, gradEvals, proxEvals, metrics } = sim;
      const lbfgsActive = visibleMethods.lbfgs;

      const vGd = metrics.gd[metric][K];
      const vApd = metrics.apd[metric][K];
      const vLbfgs = metrics.lbfgs[metric][K];
      if (gapBadge) {
        if (isComposite(problem) && lbfgsActive) {
          const ordersLb = Math.log10(Math.max(1, vLbfgs / Math.max(vApd, 1e-16)));
          if (ordersLb >= 1) {
            gapBadge.textContent = `APD ~10^${ordersLb.toFixed(1)}× better than L-BFGS`;
          } else {
            const orders = Math.log10(Math.max(1, vGd / Math.max(vApd, 1e-16)));
            gapBadge.textContent =
              orders >= 1 ? `APD ~10^${orders.toFixed(1)}× better than GD` : `k=${K}: APD=${vApd.toExponential(1)}`;
          }
        } else {
          const orders = Math.log10(Math.max(1, vGd / Math.max(vApd, 1e-16)));
          gapBadge.textContent =
            orders >= 1 ? `APD ~10^${orders.toFixed(1)}× better than GD` : `k=${K}: APD=${vApd.toExponential(1)}`;
        }
      }

      // Live numeric readout strip
      if (readoutEl) {
        const entries = [
          { name: 'GD', color: '#ef4444', val: metrics.gd[metric][K], show: visibleMethods.gd },
          { name: 'BT-GD', color: '#f59e0b', val: metrics.agd[metric][K], show: visibleMethods.agd },
          { name: 'NAG', color: '#8b5cf6', val: metrics.nag[metric][K], show: visibleMethods.nag },
          { name: 'Adapt-NAG', color: '#0ea5e9', val: metrics.anag[metric][K], show: visibleMethods.anag },
          { name: 'Proxax APD', color: '#10b981', val: metrics.apd[metric][K], show: visibleMethods.apd },
          { name: 'Adam', color: '#f472b6', val: metrics.adam[metric][K], show: visibleMethods.adam },
          {
            name: 'L-BFGS',
            color: lbfgsColor,
            val: lbfgsActive ? metrics.lbfgs[metric][K] : null,
            show: lbfgsActive,
          },
        ].filter((e) => e.show);

        readoutEl.innerHTML =
          `<span class="font-semibold text-[var(--text)]">k = ${K}:</span>` +
          entries
            .map(
              (e) =>
                `<span class="inline-flex items-center gap-1.5"><span style="background:${e.color}" class="inline-block h-2 w-2 rounded-full"></span>${e.name}: <strong class="text-[var(--text)]">${e.val.toExponential(1)}</strong></span>`
            )
            .join('');
      }

      // ---- 1. Left Canvas (2D Contours OR High-Dim Visualization) ----
      if (isHighDim(problem)) {
        drawHighDimLeft(sim, K, isDark, gridColor, axisColor, textColor, lbfgsColor);
      } else {
        const baseBounds = get2DBounds(param);
        const baseW = baseBounds.xMax - baseBounds.xMin;
        const baseH = baseBounds.yMax - baseBounds.yMin;
        const aspect = contourCanvas.width / contourCanvas.height;

        if (autoZoom && K > 0) {
          const focusPts = [];
          if (visibleMethods.gd) focusPts.push(trajs.gd[K]);
          if (visibleMethods.agd) focusPts.push(trajs.agd[K]);
          if (visibleMethods.nag) focusPts.push(trajs.nag[K]);
          if (visibleMethods.anag) focusPts.push(trajs.anag[K]);
          if (visibleMethods.adam) focusPts.push(trajs.adam[K]);
          if (visibleMethods.apd) focusPts.push(trajs.apd[K]);
          if (lbfgsActive) focusPts.push(trajs.lbfgs[K]);

          if (focusPts.length > 0) {
            const refPt = visibleMethods.apd ? trajs.apd[K] : focusPts[0];
            let nearestOpt = optima[0],
              bestD = Infinity;
            optima.forEach((opt) => {
              const dd = Math.hypot(refPt[0] - opt[0], refPt[1] - opt[1]);
              if (dd < bestD) {
                bestD = dd;
                nearestOpt = opt;
              }
            });
            focusPts.push(nearestOpt);

            let minX = Infinity,
              maxX = -Infinity,
              minY = Infinity,
              maxY = -Infinity;
            focusPts.forEach((p) => {
              if (p[0] < minX) minX = p[0];
              if (p[0] > maxX) maxX = p[0];
              if (p[1] < minY) minY = p[1];
              if (p[1] > maxY) maxY = p[1];
            });
            const cx = 0.5 * (minX + maxX),
              cy = 0.5 * (minY + maxY);
            let spanX = Math.max((maxX - minX) * 1.6, baseW * 0.008);
            let spanY = Math.max((maxY - minY) * 1.6, baseH * 0.008);
            if (spanX / spanY > aspect) spanY = spanX / aspect;
            else spanX = spanY * aspect;
            viewBox =
              spanX >= baseW * 0.96 || spanY >= baseH * 0.96
                ? null
                : { xMin: cx - 0.5 * spanX, xMax: cx + 0.5 * spanX, yMin: cy - 0.5 * spanY, yMax: cy + 0.5 * spanY };
          }
        } else if (autoZoom && K === 0) {
          viewBox = null;
        }

        if (zoomLevelEl) {
          const vbCur = getViewBounds(param);
          const scale = baseW / Math.max(vbCur.xMax - vbCur.xMin, 1e-9);
          if (scale > 1.05) {
            zoomLevelEl.textContent = scale >= 10 ? `${Math.round(scale)}×` : `${scale.toFixed(1)}×`;
            zoomLevelEl.classList.remove('hidden');
          } else {
            zoomLevelEl.classList.add('hidden');
          }
        }

        const W = contourCanvas.width,
          H = contourCanvas.height;
        cCtx.putImageData(renderHeatmapBg(W, H, param, P, fStar, isDark), 0, 0);
        const { xMin, xMax, yMin, yMax, x0 } = getViewBounds(param);
        const toX = (x) => ((x - xMin) / (xMax - xMin)) * W;
        const toY = (y) => H - ((y - yMin) / (yMax - yMin)) * H;

        if (problem === 'lasso') {
          cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.28)' : 'rgba(19,32,24,0.25)';
          cCtx.setLineDash([4, 4]);
          cCtx.lineWidth = 1.2;
          cCtx.beginPath();
          cCtx.moveTo(0, toY(0));
          cCtx.lineTo(W, toY(0));
          cCtx.moveTo(toX(0), 0);
          cCtx.lineTo(toX(0), H);
          cCtx.stroke();
          cCtx.setLineDash([]);
        } else if (problem === 'box_qp') {
          cCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.55)' : 'rgba(19,32,24,0.48)';
          cCtx.setLineDash([5, 4]);
          cCtx.lineWidth = 1.5;
          cCtx.strokeRect(toX(-1), toY(1), toX(1) - toX(-1), toY(-1) - toY(1));
          cCtx.setLineDash([]);
        } else if (problem === 'rosenbrock') {
          cCtx.strokeStyle = isDark ? 'rgba(52,211,153,0.35)' : 'rgba(21,128,61,0.28)';
          cCtx.setLineDash([4, 4]);
          cCtx.lineWidth = 1.2;
          cCtx.beginPath();
          for (let sx = xMin; sx <= xMax; sx += (xMax - xMin) / 100) {
            const px = toX(sx),
              py = toY(sx * sx);
            if (sx === xMin) cCtx.moveTo(px, py);
            else cCtx.lineTo(px, py);
          }
          cCtx.stroke();
          cCtx.setLineDash([]);
        }

        function drawTrail(pts, color, width, dashed) {
          const tStride = Math.max(1, Math.floor((K + 1) / 1200));
          cCtx.strokeStyle = color;
          cCtx.lineWidth = width;
          cCtx.lineJoin = 'round';
          cCtx.setLineDash(dashed ? [6, 3] : []);
          cCtx.beginPath();
          for (let i = 0; i <= K; i += tStride) {
            const px = toX(pts[i][0]),
              py = toY(pts[i][1]);
            if (i === 0) cCtx.moveTo(px, py);
            else cCtx.lineTo(px, py);
          }
          const last = pts[K];
          cCtx.lineTo(toX(last[0]), toY(last[1]));
          cCtx.stroke();
          cCtx.setLineDash([]);

          cCtx.fillStyle = color;
          cCtx.strokeStyle = isDark ? '#09110d' : '#ffffff';
          cCtx.lineWidth = 1.5;
          cCtx.beginPath();
          cCtx.arc(toX(last[0]), toY(last[1]), 4.5, 0, Math.PI * 2);
          cCtx.fill();
          cCtx.stroke();
        }

        if (visibleMethods.gd) drawTrail(trajs.gd, '#ef4444', 1.9, false);
        if (visibleMethods.agd) drawTrail(trajs.agd, '#f59e0b', 1.9, false);
        if (visibleMethods.nag) drawTrail(trajs.nag, '#8b5cf6', 1.9, false);
        if (visibleMethods.anag) drawTrail(trajs.anag, '#0ea5e9', 1.9, false);
        if (visibleMethods.adam) drawTrail(trajs.adam, '#f472b6', 1.9, false);
        if (visibleMethods.apd) drawTrail(trajs.apd, '#10b981', 2.6, false);
        if (lbfgsActive) drawTrail(trajs.lbfgs, lbfgsColor, 2.0, true);

        cCtx.fillStyle = isDark ? '#ecf4ef' : '#132018';
        cCtx.beginPath();
        cCtx.arc(toX(x0[0]), toY(x0[1]), 4.5, 0, Math.PI * 2);
        cCtx.fill();
        cCtx.font = 'bold 11px JetBrains Mono, monospace';
        cCtx.fillText('x₀', toX(x0[0]) + 7, toY(x0[1]) - 6);

        optima.forEach((opt, idx) => {
          cCtx.fillStyle = isDark ? '#34d399' : '#15803d';
          cCtx.strokeStyle = isDark ? '#09110d' : '#ffffff';
          cCtx.lineWidth = 1.5;
          cCtx.beginPath();
          cCtx.arc(toX(opt[0]), toY(opt[1]), 5, 0, Math.PI * 2);
          cCtx.fill();
          cCtx.stroke();
          if (optima.length === 1 || idx === 0) {
            cCtx.fillStyle = isDark ? '#ecf4ef' : '#132018';
            cCtx.fillText('x*', toX(opt[0]) + 8, toY(opt[1]) - 6);
          }
        });
      }

      // ---- 2. Right Canvas: Log-Scale Convergence Curve ----
      const GW = curveCanvas.width,
        GH = curveCanvas.height;
      gCtx.clearRect(0, 0, GW, GH);
      const pad = { l: 50, r: 16, t: 18, b: 30 };
      const plotW = GW - pad.l - pad.r,
        plotH = GH - pad.t - pad.b;
      const minLog = -14,
        maxLog = 3;

      const useProxAxis = xAxisMode === 'prox' && Boolean(P.prox);
      const activeEvals = useProxAxis ? proxEvals : gradEvals;
      let maxXVal = 1;
      if (visibleMethods.gd) maxXVal = Math.max(maxXVal, activeEvals.gd[K]);
      if (visibleMethods.agd) maxXVal = Math.max(maxXVal, activeEvals.agd[K]);
      if (visibleMethods.nag) maxXVal = Math.max(maxXVal, activeEvals.nag[K]);
      if (visibleMethods.anag) maxXVal = Math.max(maxXVal, activeEvals.anag[K]);
      if (visibleMethods.adam) maxXVal = Math.max(maxXVal, activeEvals.adam[K]);
      if (visibleMethods.apd) maxXVal = Math.max(maxXVal, activeEvals.apd[K]);
      if (lbfgsActive && !useProxAxis) maxXVal = Math.max(maxXVal, activeEvals.lbfgs[K]);

      const gx = (xVal) => pad.l + (xVal / Math.max(1, maxXVal)) * plotW;
      const gy = (val) => {
        const lg = Math.max(minLog, Math.min(maxLog, Math.log10(Math.max(val, 1e-16))));
        return pad.t + ((maxLog - lg) / (maxLog - minLog)) * plotH;
      };

      gCtx.font = '10px JetBrains Mono, monospace';
      gCtx.fillStyle = textColor;
      for (let p = minLog; p <= maxLog; p += 2) {
        const y = pad.t + ((maxLog - p) / (maxLog - minLog)) * plotH;
        gCtx.strokeStyle = gridColor;
        gCtx.lineWidth = 1;
        gCtx.beginPath();
        gCtx.moveTo(pad.l, y);
        gCtx.lineTo(GW - pad.r, y);
        gCtx.stroke();
        gCtx.fillText(`10^${p}`, 4, y + 3);
      }

      gCtx.strokeStyle = axisColor;
      gCtx.beginPath();
      gCtx.moveTo(pad.l, pad.t);
      gCtx.lineTo(pad.l, GH - pad.b);
      gCtx.lineTo(GW - pad.r, GH - pad.b);
      gCtx.stroke();
      gCtx.fillText('0', pad.l - 2, GH - 10);
      gCtx.fillText(
        useProxAxis ? `prox = ${maxXVal}` : `grad = ${maxXVal}`,
        GW - pad.r - 78,
        GH - 10
      );

      const stride = Math.max(1, Math.floor((K + 1) / 450));
      function drawCurve(arr, evArr, color, width, dashed) {
        gCtx.strokeStyle = color;
        gCtx.lineWidth = width;
        gCtx.setLineDash(dashed ? [6, 3] : []);
        gCtx.beginPath();
        for (let k = 0; k <= K; k += stride) {
          const px = gx(evArr[k]),
            py = gy(arr[k]);
          if (k === 0) gCtx.moveTo(px, py);
          else gCtx.lineTo(px, py);
        }
        gCtx.lineTo(gx(evArr[K]), gy(arr[K]));
        gCtx.stroke();
        gCtx.setLineDash([]);
      }

      if (visibleMethods.gd) drawCurve(metrics.gd[metric], activeEvals.gd, '#ef4444', 2.0, false);
      if (visibleMethods.agd) drawCurve(metrics.agd[metric], activeEvals.agd, '#f59e0b', 2.0, false);
      if (visibleMethods.nag) drawCurve(metrics.nag[metric], activeEvals.nag, '#8b5cf6', 2.0, false);
      if (visibleMethods.anag) drawCurve(metrics.anag[metric], activeEvals.anag, '#0ea5e9', 2.0, false);
      if (visibleMethods.adam) drawCurve(metrics.adam[metric], activeEvals.adam, '#f472b6', 2.0, false);
      if (visibleMethods.apd) drawCurve(metrics.apd[metric], activeEvals.apd, '#10b981', 2.6, false);
      if (lbfgsActive && !useProxAxis) drawCurve(metrics.lbfgs[metric], activeEvals.lbfgs, lbfgsColor, 2.0, true);

      // Hover crosshair + live tooltip on convergence curve
      if (hoverK !== null && K > 0) {
        const hoverX = Math.max(0, Math.min(maxXVal, Math.round((hoverK / Math.max(1, K)) * maxXVal)));
        const hx = gx(hoverX);
        const findIdxAtEval = (evArr, target) => {
          let lo = 0,
            hi = K;
          while (lo < hi) {
            const mid = (lo + hi + 1) >> 1;
            if (evArr[mid] <= target) lo = mid;
            else hi = mid - 1;
          }
          return lo;
        };
        gCtx.save();
        gCtx.strokeStyle = isDark ? 'rgba(236,244,239,0.45)' : 'rgba(19,32,24,0.4)';
        gCtx.lineWidth = 1;
        gCtx.setLineDash([3, 3]);
        gCtx.beginPath();
        gCtx.moveTo(hx, pad.t);
        gCtx.lineTo(hx, GH - pad.b);
        gCtx.stroke();
        gCtx.setLineDash([]);

        const hoverSeries = [
          { name: 'Classic GD', color: '#ef4444', m: metrics.gd[metric], ev: activeEvals.gd, show: visibleMethods.gd },
          { name: 'BT-GD', color: '#f59e0b', m: metrics.agd[metric], ev: activeEvals.agd, show: visibleMethods.agd },
          { name: 'Classic NAG', color: '#8b5cf6', m: metrics.nag[metric], ev: activeEvals.nag, show: visibleMethods.nag },
          { name: 'Adapt-NAG', color: '#0ea5e9', m: metrics.anag[metric], ev: activeEvals.anag, show: visibleMethods.anag },
          { name: 'Proxax APD', color: '#10b981', m: metrics.apd[metric], ev: activeEvals.apd, show: visibleMethods.apd },
          { name: 'Adam', color: '#f472b6', m: metrics.adam[metric], ev: activeEvals.adam, show: visibleMethods.adam },
          {
            name: 'L-BFGS',
            color: lbfgsColor,
            m: metrics.lbfgs[metric],
            ev: activeEvals.lbfgs,
            show: lbfgsActive && !useProxAxis,
          },
        ]
          .filter((s) => s.show && hoverX <= s.ev[K])
          .map((s) => {
            const idx = findIdxAtEval(s.ev, hoverX);
            return { name: s.name, color: s.color, val: s.m[idx] };
          });

        hoverSeries.forEach((s) => {
          gCtx.fillStyle = s.color;
          gCtx.strokeStyle = isDark ? '#09110d' : '#ffffff';
          gCtx.lineWidth = 1.4;
          gCtx.beginPath();
          gCtx.arc(hx, gy(s.val), 3.6, 0, Math.PI * 2);
          gCtx.fill();
          gCtx.stroke();
        });
        gCtx.restore();

        if (curveTooltip) {
          const onRightHalf = hx > GW * 0.55;
          curveTooltip.style.left = onRightHalf ? 'auto' : `${Math.min(72, (hx / GW) * 100 + 2)}%`;
          curveTooltip.style.right = onRightHalf ? `${Math.min(72, ((GW - hx) / GW) * 100 + 2)}%` : 'auto';
          const axisTag = useProxAxis ? `prox = ${hoverX}` : `grad = ${hoverX}`;
          curveTooltip.innerHTML =
            `<div class="mb-1 font-semibold text-[var(--accent)]">${axisTag} <span class="font-normal text-[var(--text-muted)]">(click to jump)</span></div>` +
            hoverSeries
              .map(
                (s) =>
                  `<div class="flex items-center justify-between gap-3"><span class="inline-flex items-center gap-1.5"><span style="background:${s.color}" class="inline-block h-1.5 w-1.5 rounded-full"></span>${s.name}</span><span class="font-semibold">${s.val.toExponential(1)}</span></div>`
              )
              .join('');
          curveTooltip.classList.remove('hidden');
        }
      } else if (curveTooltip) {
        curveTooltip.classList.add('hidden');
      }
    }

    function getAnimStep() {
      const raw = Number(animStepInput?.value);
      return Number.isFinite(raw) && raw >= 1 ? Math.round(raw) : 100;
    }

    function syncLbfgsState() {
      const smoothed = isComposite(problem);
      if (lbfgsBtn) {
        lbfgsBtn.disabled = false;
        lbfgsBtn.classList.remove('cursor-not-allowed');
        lbfgsBtn.classList.toggle('opacity-35', !visibleMethods.lbfgs);
        lbfgsBtn.classList.toggle('line-through', !visibleMethods.lbfgs);
      }
      if (lbfgsNote) {
        lbfgsNote.textContent =
          problem === 'simplex_qp' ? '(softmax)' : problem === 'box_qp' ? '(tanh)' : '(smoothed)';
        lbfgsNote.classList.toggle('hidden', !smoothed);
      }
    }

    function syncAutoZoomBtn() {
      if (!zoomAutoBtn) return;
      zoomAutoBtn.setAttribute('aria-pressed', String(autoZoom));
      zoomAutoBtn.className = autoZoom
        ? 'rounded bg-[var(--accent)] px-1.5 py-0.5 font-mono text-[10px] text-white transition-colors'
        : 'rounded px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-muted)] transition-colors hover:bg-[var(--surface-subtle)] hover:text-[var(--text)]';
    }

    function syncMetricUI() {
      const disableObj = problem === 'box_qp';
      if (disableObj && metric === 'obj') metric = 'grad';
      metricBtns.forEach((b) => {
        const m = b.dataset.homeMetric;
        const isDisabled = disableObj && m === 'obj';
        const active = m === metric;
        b.disabled = isDisabled;
        b.title = isDisabled ? 'Disabled on Indefinite Box QP (multiple local minima with distinct values)' : '';
        b.className = isDisabled
          ? 'home-metric-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] opacity-35 cursor-not-allowed line-through'
          : active
            ? 'home-metric-btn rounded-md bg-[var(--surface)] px-2.5 py-1 text-[var(--text)] shadow-xs'
            : 'home-metric-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]';
      });
      Object.entries(curveTitles).forEach(([k, el]) => el?.classList.toggle('hidden', k !== metric));
    }

    function syncXAxisUI() {
      const hasProx = isComposite(problem);
      if (!hasProx && xAxisMode === 'prox') xAxisMode = 'grad';
      xAxisProxBtn?.classList.toggle('hidden', !hasProx);
      xAxisBtns.forEach((b) => {
        const m = b.dataset.homeXaxis;
        if (m === 'prox' && !hasProx) return;
        const active = m === xAxisMode;
        b.className = active
          ? 'home-xaxis-btn rounded bg-[var(--surface)] px-2 py-0.5 font-semibold text-[var(--text)] shadow-xs'
          : 'home-xaxis-btn rounded px-2 py-0.5 text-[var(--text-muted)] hover:text-[var(--text)]';
      });
      xAxisLabels.forEach((el) => {
        if (el) el.textContent = xAxisMode === 'prox' ? 'Prox Evals' : 'Grad Evals';
      });
    }

    function updateProblemUI() {
      probBtns.forEach((btn) => {
        const active = btn.dataset.homeProblem === problem;
        btn.className = active
          ? 'home-prob-btn rounded-md bg-[var(--accent)] px-2.5 py-1 text-white transition-colors'
          : 'home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]';
      });
      Object.entries(contourTitles).forEach(([k, el]) => el?.classList.toggle('hidden', k !== problem));
      Object.entries(objectiveRows).forEach(([k, el]) => {
        if (!el) return;
        const active = k === problem;
        el.classList.toggle('hidden', !active);
        el.classList.toggle('flex', active);
      });
      Object.entries(noteRows).forEach(([k, el]) => el?.classList.toggle('hidden', k !== problem));
      syncMetricUI();
      syncXAxisUI();

      const lblKey =
        problem === 'rosenbrock' || problem === 'chained_rosen'
          ? 'rosen'
          : problem === 'quadratic' || problem === 'spec_quad'
            ? 'quad'
            : problem === 'himmelblau'
              ? 'himm'
              : problem === 'simplex_qp'
                ? 'simplex'
                : problem === 'box_qp'
                  ? 'box'
                  : 'lasso';
      Object.entries(paramLabelEls).forEach(([k, el]) => el?.classList.toggle('hidden', k !== lblKey));

      // Hide 2D zoom/pan overlay on high-dim plots
      const hd = isHighDim(problem);
      zoomToolbar?.classList.toggle('hidden', hd);
      contourCanvas.classList.toggle('cursor-grab', !hd);

      if (problem === 'rosenbrock') {
        paramSlider.min = '15';
        paramSlider.max = '180';
        paramSlider.step = '5';
        paramSlider.value = '100';
        iterSlider.min = '0';
        iterSlider.max = '14000';
        iterSlider.value = '10000';
        animStepInput.value = '100';
      } else if (problem === 'quadratic') {
        paramSlider.min = '50';
        paramSlider.max = '1000';
        paramSlider.step = '25';
        paramSlider.value = '500';
        iterSlider.min = '0';
        iterSlider.max = '10000';
        iterSlider.value = '4800';
        animStepInput.value = '100';
      } else if (problem === 'himmelblau') {
        paramSlider.min = '0';
        paramSlider.max = '360';
        paramSlider.step = '5';
        paramSlider.value = '210';
        iterSlider.min = '0';
        iterSlider.max = '600';
        iterSlider.value = '200';
        animStepInput.value = '5';
      } else if (problem === 'lasso') {
        paramSlider.min = '0.2';
        paramSlider.max = '2.0';
        paramSlider.step = '0.1';
        paramSlider.value = '1.0';
        iterSlider.min = '0';
        iterSlider.max = '1200';
        iterSlider.value = '400';
        animStepInput.value = '10';
      } else if (problem === 'box_qp') {
        paramSlider.min = '1';
        paramSlider.max = '12';
        paramSlider.step = '1';
        paramSlider.value = '5';
        iterSlider.min = '0';
        iterSlider.max = '200';
        iterSlider.value = '60';
        animStepInput.value = '2';
      } else if (problem === 'chained_rosen') {
        paramSlider.min = '10';
        paramSlider.max = '100';
        paramSlider.step = '5';
        paramSlider.value = '50';
        iterSlider.min = '0';
        iterSlider.max = '1200';
        iterSlider.value = '600';
        animStepInput.value = '10';
      } else if (problem === 'sparse_lasso') {
        paramSlider.min = '0.05';
        paramSlider.max = '0.50';
        paramSlider.step = '0.05';
        paramSlider.value = '0.15';
        iterSlider.min = '0';
        iterSlider.max = '800';
        iterSlider.value = '300';
        animStepInput.value = '10';
      } else if (problem === 'simplex_qp') {
        paramSlider.min = '0.0';
        paramSlider.max = '0.5';
        paramSlider.step = '0.05';
        paramSlider.value = '0.05';
        iterSlider.min = '0';
        iterSlider.max = '600';
        iterSlider.value = '200';
        animStepInput.value = '5';
      } else if (problem === 'nuc_norm') {
        paramSlider.min = '0.05';
        paramSlider.max = '1.00';
        paramSlider.step = '0.05';
        paramSlider.value = '0.25';
        iterSlider.min = '0';
        iterSlider.max = '400';
        iterSlider.value = '200';
        animStepInput.value = '5';
      } else if (problem === 'group_lasso') {
        paramSlider.min = '0.05';
        paramSlider.max = '0.80';
        paramSlider.step = '0.05';
        paramSlider.value = '0.25';
        iterSlider.min = '0';
        iterSlider.max = '600';
        iterSlider.value = '250';
        animStepInput.value = '5';
      } else if (problem === 'sparse_logreg') {
        paramSlider.min = '0.005';
        paramSlider.max = '0.060';
        paramSlider.step = '0.005';
        paramSlider.value = '0.015';
        iterSlider.min = '0';
        iterSlider.max = '600';
        iterSlider.value = '250';
        animStepInput.value = '5';
      } else {
        // spec_quad
        paramSlider.min = '100';
        paramSlider.max = '10000';
        paramSlider.step = '100';
        paramSlider.value = '2000';
        iterSlider.min = '0';
        iterSlider.max = '800';
        iterSlider.value = '100';
        animStepInput.value = '5';
      }

      iterSlider.step = String(getAnimStep());
      viewBox = null;
      cachedBgKey = '';
      syncLbfgsState();
      draw();
    }

    function zoomAt(factor, cxFrac, cyFrac) {
      if (isHighDim(problem)) return;
      autoZoom = false;
      syncAutoZoomBtn();
      const param = Number(paramSlider.value);
      const vb = getViewBounds(param);
      const curW = vb.xMax - vb.xMin,
        curH = vb.yMax - vb.yMin;
      const newW = curW * factor,
        newH = curH * factor;
      const cx = vb.xMin + cxFrac * curW,
        cy = vb.yMax - cyFrac * curH;
      viewBox = {
        xMin: cx - cxFrac * newW,
        xMax: cx + (1 - cxFrac) * newW,
        yMin: cy - (1 - cyFrac) * newH,
        yMax: cy + cyFrac * newH,
      };
      cachedBgKey = '';
      draw();
    }

    zoomAutoBtn?.addEventListener('click', () => {
      autoZoom = !autoZoom;
      if (!autoZoom) viewBox = null;
      cachedBgKey = '';
      syncAutoZoomBtn();
      draw();
    });
    zoomInBtn?.addEventListener('click', () => zoomAt(0.6, 0.5, 0.5));
    zoomOutBtn?.addEventListener('click', () => zoomAt(1.6, 0.5, 0.5));
    zoomResetBtn?.addEventListener('click', () => {
      autoZoom = false;
      viewBox = null;
      cachedBgKey = '';
      syncAutoZoomBtn();
      draw();
    });

    contourCanvas.addEventListener('dblclick', (e) => {
      if (isHighDim(problem)) return;
      const rect = contourCanvas.getBoundingClientRect();
      zoomAt(0.55, (e.clientX - rect.left) / rect.width, (e.clientY - rect.top) / rect.height);
    });

    contourCanvas.addEventListener('pointerdown', (e) => {
      if (isHighDim(problem)) return;
      autoZoom = false;
      syncAutoZoomBtn();
      const vb = getViewBounds(Number(paramSlider.value));
      isDragging = true;
      dragStart = { clientX: e.clientX, clientY: e.clientY, xMin: vb.xMin, xMax: vb.xMax, yMin: vb.yMin, yMax: vb.yMax };
      contourCanvas.setPointerCapture(e.pointerId);
    });

    contourCanvas.addEventListener('pointermove', (e) => {
      if (!isDragging || !dragStart || isHighDim(problem)) return;
      const rect = contourCanvas.getBoundingClientRect();
      const dxFrac = (e.clientX - dragStart.clientX) / rect.width;
      const dyFrac = (e.clientY - dragStart.clientY) / rect.height;
      const spanX = dragStart.xMax - dragStart.xMin,
        spanY = dragStart.yMax - dragStart.yMin;
      viewBox = {
        xMin: dragStart.xMin - dxFrac * spanX,
        xMax: dragStart.xMax - dxFrac * spanX,
        yMin: dragStart.yMin + dyFrac * spanY,
        yMax: dragStart.yMax + dyFrac * spanY,
      };
      cachedBgKey = '';
      draw();
    });

    const endDrag = () => {
      isDragging = false;
      dragStart = null;
    };
    contourCanvas.addEventListener('pointerup', endDrag);
    contourCanvas.addEventListener('pointercancel', endDrag);

    // Convergence plot hover crosshair + click-to-scrub
    function mapCurveEventToK(e) {
      const rect = curveCanvas.getBoundingClientRect();
      const mx = ((e.clientX - rect.left) / rect.width) * curveCanvas.width;
      const padL = 50,
        padR = 16;
      const plotW = curveCanvas.width - padL - padR;
      const frac = Math.max(0, Math.min(1, (mx - padL) / plotW));
      const K = Number(iterSlider.value);
      return Math.round(frac * K);
    }
    curveCanvas.addEventListener('pointermove', (e) => {
      hoverK = mapCurveEventToK(e);
      draw();
    });
    curveCanvas.addEventListener('pointerleave', () => {
      hoverK = null;
      draw();
    });
    curveCanvas.addEventListener('click', (e) => {
      const targetK = mapCurveEventToK(e);
      if (animId) {
        clearInterval(animId);
        animId = null;
        playBtn.textContent = 'Play';
      }
      iterSlider.value = String(targetK);
      hoverK = null;
      draw();
    });

    probBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        problem = btn.dataset.homeProblem || 'rosenbrock';
        updateProblemUI();
      })
    );

    metricBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const targetMetric = btn.dataset.homeMetric || 'obj';
        if (problem === 'box_qp' && targetMetric === 'obj') return;
        metric = targetMetric;
        syncMetricUI();
        draw();
      })
    );

    methodBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const key = btn.dataset.homeMethod;
        if (!key || !(key in visibleMethods)) return;
        visibleMethods[key] = !visibleMethods[key];
        const on = visibleMethods[key];
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.toggle('opacity-35', !on);
        btn.classList.toggle('line-through', !on);
        draw();
      })
    );

    paramSlider?.addEventListener('input', draw);
    iterSlider?.addEventListener('input', draw);
    window.addEventListener('theme-change', () => {
      cachedBgKey = '';
      draw();
    });

    animStepInput?.addEventListener('input', () => {
      iterSlider.step = String(getAnimStep());
    });

    resetBtn?.addEventListener('click', () => {
      if (animId) {
        clearInterval(animId);
        animId = null;
        playBtn.textContent = 'Play';
      }
      iterSlider.value = '0';
      draw();
    });

    function getAnimIntervalMs() {
      const fps = Math.max(1, Math.min(60, Number(animFpsSlider?.value) || 20));
      return Math.round(1000 / fps);
    }

    function startAnimLoop() {
      if (animId) clearInterval(animId);
      const targetMax = Number(iterSlider.max);
      animId = setInterval(() => {
        const cur = Number(iterSlider.value);
        const step = getAnimStep();
        if (cur >= targetMax) {
          clearInterval(animId);
          animId = null;
          playBtn.textContent = 'Play';
          return;
        }
        iterSlider.value = String(Math.min(targetMax, cur + step));
        draw();
      }, getAnimIntervalMs());
    }

    animFpsSlider?.addEventListener('input', () => {
      if (animFpsVal) animFpsVal.textContent = `${animFpsSlider.value}/s`;
      if (animId) startAnimLoop();
    });

    playBtn?.addEventListener('click', () => {
      if (animId) {
        clearInterval(animId);
        animId = null;
        playBtn.textContent = 'Play';
        return;
      }
      const targetMax = Number(iterSlider.max);
      if (Number(iterSlider.value) >= targetMax) iterSlider.value = '0';
      playBtn.textContent = 'Pause';
      draw();
      startAnimLoop();
    });

    xAxisBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const targetAxis = btn.dataset.homeXaxis || 'grad';
        if (targetAxis === 'prox' && !isComposite(problem)) return;
        xAxisMode = targetAxis;
        syncXAxisUI();
        hoverK = null;
        draw();
      })
    );

    shareBtn?.addEventListener('click', async () => {
      const url = new URL(window.location.href);
      url.searchParams.set('prob', problem);
      url.searchParams.set('param', paramSlider.value);
      url.searchParams.set('k', iterSlider.value);
      url.searchParams.set('metric', metric);
      if (xAxisMode === 'prox' && isComposite(problem)) url.searchParams.set('x', 'prox');
      else url.searchParams.delete('x');
      url.hash = 'proxax-home-demo';
      window.history.replaceState({}, '', url.toString());
      try {
        await navigator.clipboard.writeText(url.toString());
        if (shareLabel) {
          shareLabel.textContent = 'Link Copied ✓';
          setTimeout(() => {
            shareLabel.textContent = 'Share';
          }, 1600);
        }
      } catch {
        if (shareLabel) shareLabel.textContent = 'URL Updated';
      }
    });

    // Hydrate state from URL query params if present (?prob=...&param=...&k=...&metric=...&x=prox)
    const initParams = new URLSearchParams(window.location.search);
    const qProb = initParams.get('prob');
    if (qProb && qProb in contourTitles) {
      problem = qProb;
      updateProblemUI();
      const qParam = initParams.get('param');
      if (qParam !== null && Number.isFinite(Number(qParam))) paramSlider.value = qParam;
      const qK = initParams.get('k');
      if (qK !== null && Number.isFinite(Number(qK))) iterSlider.value = qK;
      const qMetric = initParams.get('metric');
      if (qMetric && ['obj', 'grad', 'dist'].includes(qMetric)) {
        metric = qMetric;
        syncMetricUI();
      }
      if (initParams.get('x') === 'prox' && isComposite(problem)) {
        xAxisMode = 'prox';
        syncXAxisUI();
      }
      draw();
    } else {
      syncLbfgsState();
      syncAutoZoomBtn();
      syncXAxisUI();
      draw();
    }
  })();
</script>
