---
import katex from 'katex';
import { Code } from 'astro:components';

const tex = (expr: string) =>
  katex.renderToString(expr, { throwOnError: false, strict: false });

const kRosenTitle = tex('f(x_1, x_2) = (1 - x_1)^2 + b(x_2 - x_1^2)^2');
const kQuadTitle = tex('f(x_1, x_2) = \\tfrac{1}{2}(x_1^2 + \\kappa x_2^2)');
const kHimmTitle = tex('f(x_1, x_2) = (x_1^2 + x_2 - 11)^2 + (x_1 + x_2^2 - 7)^2');
const kL1Title = tex('\\phi(x) = \\tfrac{1}{2}x^{\\top}Qx - c^{\\top}x + \\lambda\\|x\\|_1');
const kBoxTitle = tex('\\min_{x \\in [-1,1]^2} \\tfrac{1}{2}x^{\\top}Hx + c^{\\top}x \\;(\\lambda_1 = -\\alpha < 0)');
const kChainedTitle = tex('f(x) = \\sum_{i=1}^{49}\\bigl[(1-x_i)^2 + b(x_{i+1}-x_i^2)^2\\bigr]');
const kSparseTitle = tex('\\phi(x) = \\tfrac{1}{2}\\|Ax - y\\|_2^2 + \\lambda\\|x\\|_1 \\;(d=64)');
const kSimplexTitle = tex('\\min_{x \\in \\Delta^{63}} \\tfrac{1}{2}\\|Ax - b\\|_2^2 + \\tfrac{\\mu}{2}\\|x\\|_2^2');
const kNucTitle = tex('\\min_{X \\in \\mathbb{S}^8} \\tfrac{1}{2}\\|P_\\Omega(X - M^*)\\|_F^2 + \\lambda\\|X\\|_*');
const kGroupTitle = tex('\\phi(x) = \\tfrac{1}{2}\\|Ax - y\\|_2^2 + \\lambda\\sum_{g=1}^{8}\\|x_g\\|_2');
const kLogRegTitle = tex('\\phi(x) = \\tfrac{1}{n}\\sum_i \\log(1 + e^{-y_i a_i^\\top x}) + \\lambda\\|x\\|_1');
const kSpecTitle = tex('f(x) = \\tfrac{1}{2}(x - x^*)^{\\top} Q \\Lambda Q^{\\top} (x - x^*),\\; \\lambda_i \\in [1, \\kappa]');

const kParamRosen = tex('b');
const kParamQuad = tex('\\kappa = L/\\mu');
const kParamHimm = tex('\\theta_0');
const kParamL1 = tex('\\lambda');
const kParamSimplex = tex('\\mu');
const kParamBox = tex('\\alpha');

const kIterK = tex('k');
const kObjMetric = tex('f(x_k) - f^*');
const kGradMetric = tex('\\|\\nabla f(x_k)\\|');
const kDistMetric = tex('\\|x_k - x^*\\|');

const kCurveObj = tex('\\log_{10}(f(x_k) - f^*)');
const kCurveGrad = tex('\\log_{10}\\|\\nabla f(x_k)\\|');
const kCurveDist = tex('\\log_{10}\\|x_k - x^*\\|');

const kL1Btn = tex('\\ell_1');
const kXStar = tex('x^*');
const kL = tex('L');
const kMu = tex('\\mu');
const kHighDimD = tex('d = 50\\text{--}100');
const kLbfgsM = tex('m = 5 \\ll d');
const kClassicLipNote = tex('\\hat{L} = 2L \\;(\\eta = \\tfrac{1}{2L})');

const renderNote = (s: string) =>
  s.replace(/\$([^$]+)\$/g, (_, expr) => tex(expr));

const noteRosen = renderNote(
  'Start $x_0 = (-1.2, 1.0)$; unique global minimum at $x^* = (1, 1)$ along the curved parabola $x_2 = x_1^2$.'
);
const noteQuad = renderNote(
  'Start $x_0 = (-2.1, 0.85)$; unique minimum $x^* = (0, 0)$ with condition number $\\kappa = L/\\mu$.'
);
const noteHimm = renderNote(
  'Start $x_0 = 1.5\\,(\\cos \\theta_0, \\sin \\theta_0)$; four identical global minima ($f^* = 0$) separated by saddles.'
);
const noteLasso = renderNote(
  'Rotated quadratic $Q = R(28^\\circ)\\,\\mathrm{diag}(1, 80)\\,R(28^\\circ)^\\top$, $c = (2.4, -0.3)$, start $x_0 = (-1.8, 1.4)$.'
);
const noteBox = renderNote(
  '$H = R(25^\\circ)\\,\\mathrm{diag}(-\\alpha, 6)\\,R(25^\\circ)^\\top$, $c = (0.28, -0.18)$, start $x_0 = (0.06, -0.04)$ near the interior saddle; multiple boundary minima with distinct values ($f(x_k) - f^*$ disabled; use stationarity or distance).'
);
const noteChained = renderNote(
  'Alternating start $x_0 = (-1, 1, -1, 1, \\dots) \\in \\mathbb{R}^{50}$; unique global minimum at $x^* = (1, \\dots, 1)$.'
);
const noteSparse = renderNote(
  '$A \\in \\mathbb{R}^{48 \\times 64}$ i.i.d. $\\mathcal{N}(0, 1/48)$, $y = A x_{\\mathrm{true}}$ with 8 sparse spikes in $[0.65, 0.95]$, start $x_0 = 0$.'
);
const noteSimplex = renderNote(
  '$A \\in \\mathbb{R}^{48 \\times 64}$ i.i.d. $\\mathcal{N}(0, 1/48)$, $b = A x_{\\mathrm{true}} + \\varepsilon$ ($\\sigma = 0.04$), $x_{\\mathrm{true}} \\in \\Delta^{63}$ supported on 8 assets, start $x_0 = \\tfrac{1}{64}\\mathbf{1}$.'
);
const noteNuc = renderNote(
  '$M^* = U U^\\top$ (rank 2, $U \\in \\mathbb{R}^{8 \\times 2}$ i.i.d. $\\mathcal{N}(0, 0.9^2)$), symmetric mask $\\Omega$ with $65\\%$ entries observed, start $X_0 = 0$.'
);
const noteGroup = renderNote(
  '$A \\in \\mathbb{R}^{48 \\times 64}$ i.i.d. $\\mathcal{N}(0, 1/48)$, $y = A x_{\\mathrm{true}}$ partitioned into 8 groups of 8; 2 active groups ($g \\in \\{2, 6\\}$; norms $0.85, 0.72$), start $x_0 = 0$.'
);
const noteLogReg = renderNote(
  '$n = 80$ samples $a_i \\in \\mathbb{R}^{64}$ i.i.d. $\\mathcal{N}(0, I/64)$, labels $y_i = \\mathrm{sign}(a_i^\\top x_{\\mathrm{true}})$ with 6 active features in $[-0.95, 0.90]$, start $x_0 = 0$.'
);
const noteSpec = renderNote(
  '$\\lambda_i = \\kappa^{(i-1)/99}$, $Q = H_{12}\\cdots H_1$ (12 random Householder reflections), $x^*_i = 0.5\\sin(0.25i) \\pm 0.25$, start $x_0 = 0$.'
);

const rosenSnippet = `import jax.numpy as jnp
from proxax import px

# High-dimensional Chained Rosenbrock (d = 50, nonconvex)
def chained_rosenbrock(x):
  return jnp.sum((1.0 - x[:-1]) ** 2 + 50.0 * (x[1:] - x[:-1] ** 2) ** 2)

x0 = jnp.where(jnp.arange(50) % 2 == 0, -1.0, 1.0)
sol = px.solve(
    problem=px.CompositeProblem(smooth=chained_rosenbrock),
    x0=x0,
    solver=px.solvers.APD(opt_tol=1e-6),
)

# High-dimensional Sparse Lasso (d = 64, nonsmooth composite)
problem_lasso = px.CompositeProblem(
    smooth=lambda x: 0.5 * jnp.sum((A @ x - y) ** 2),
    proximal=px.prox.L1(weight=0.4),
)
sol_lasso = px.solve(problem_lasso, x0=jnp.zeros(64), solver=px.solvers.APD(opt_tol=1e-6))`;
---

<div id="proxax-home-demo" class="card overflow-hidden shadow-sm">
  <!-- Row 1: Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--border)] bg-[var(--surface-subtle)]/70 px-5 py-3">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="rounded-full bg-[var(--accent-soft)] px-2.5 py-0.5 font-mono text-[11px] font-semibold text-[var(--accent)]">
        Optimization Sandbox
      </span>
      <span class="text-xs text-[var(--text-muted)]">
        Inspired by{' '}
        <a
          href="https://proxax.readthedocs.io/en/latest/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-[var(--accent)] underline underline-offset-2"
          >Proxax</a
        >
      </span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="hidden font-mono text-[11px] text-[var(--text-muted)] sm:inline">12 benchmarks · 7 solvers · runs in-browser</span>
      <button
        id="home-demo-share"
        type="button"
        title="Copy a direct link to this problem & configuration"
        class="inline-flex items-center gap-1 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-2.5 py-1 font-mono text-[11px] font-medium text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        <span id="home-demo-share-label">Share</span>
      </button>
    </div>
  </div>

  <!-- Row 2: Dedicated Problems Section (Separate rows for 2D vs High-Dim) -->
  <div
    class="flex flex-col gap-2 border-b border-[var(--border)] bg-[var(--surface-subtle)]/35 px-5 py-2.5 text-xs"
    role="tablist"
    aria-label="Test problems"
  >
    <!-- 2D Row -->
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="mr-1 min-w-[4.75rem] text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">
        2D
      </span>
      <div class="inline-flex flex-wrap gap-0.5 rounded-lg border border-[var(--border)] bg-[var(--surface)] p-0.5 font-medium">
        <button
          type="button"
          data-home-problem="rosenbrock"
          class="home-prob-btn rounded-md bg-[var(--accent)] px-2.5 py-1 text-white transition-colors"
        >
          Rosenbrock
        </button>
        <button
          type="button"
          data-home-problem="quadratic"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Quadratic
        </button>
        <button
          type="button"
          data-home-problem="himmelblau"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Himmelblau
        </button>
        <button
          type="button"
          data-home-problem="lasso"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Composite <span set:html={kL1Btn} />
        </button>
        <button
          type="button"
          data-home-problem="box_qp"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Indefinite Box QP
        </button>
      </div>
    </div>

    <!-- High-Dim Row -->
    <div class="flex flex-wrap items-center gap-1.5 border-t border-[var(--border)]/60 pt-2">
      <span class="mr-1 min-w-[4.75rem] text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">
        High-Dim
      </span>
      <div class="inline-flex flex-wrap gap-0.5 rounded-lg border border-[var(--border)] bg-[var(--surface)] p-0.5 font-medium">
        <button
          type="button"
          data-home-problem="chained_rosen"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Chained Rosen <span class="font-mono text-[10px] opacity-75">50D</span>
        </button>
        <button
          type="button"
          data-home-problem="sparse_lasso"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Sparse Lasso <span class="font-mono text-[10px] opacity-75">64D</span>
        </button>
        <button
          type="button"
          data-home-problem="simplex_qp"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Simplex QP <span class="font-mono text-[10px] opacity-75">64D</span>
        </button>
        <button
          type="button"
          data-home-problem="nuc_norm"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Nuclear Norm <span class="font-mono text-[10px] opacity-75">8×8</span>
        </button>
        <button
          type="button"
          data-home-problem="group_lasso"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Group Lasso <span class="font-mono text-[10px] opacity-75">64D</span>
        </button>
        <button
          type="button"
          data-home-problem="sparse_logreg"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Sparse LogReg <span class="font-mono text-[10px] opacity-75">64D</span>
        </button>
        <button
          type="button"
          data-home-problem="spec_quad"
          class="home-prob-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          Spectrum Quad <span class="font-mono text-[10px] opacity-75">100D</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Row 2.5: Objective Function & Separate Setup Row -->
  <div class="flex flex-col gap-2 border-b border-[var(--border)] bg-[var(--bg)]/60 px-5 py-2.5 text-xs">
    <!-- Objective Row -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="mr-1 min-w-[4.75rem] text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">
        Objective
      </span>
      <div class="min-w-0 flex-1 text-sm text-[var(--text)]">
        <div id="home-obj-rosen" class="flex flex-wrap items-center justify-between gap-2">
          <span set:html={kRosenTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 2 · Nonconvex Smooth · Narrow Valley</span>
        </div>
        <div id="home-obj-quad" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kQuadTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 2 · Strongly Convex · Ill-Conditioned</span>
        </div>
        <div id="home-obj-himm" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kHimmTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 2 · Nonconvex Smooth · 4 Global Minima</span>
        </div>
        <div id="home-obj-lasso" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kL1Title} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 2 · Convex Composite · Soft-Thresholding Prox</span>
        </div>
        <div id="home-obj-box" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kBoxTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 2 · Nonconvex Composite · 2 Local Corner Minima</span>
        </div>
        <div id="home-obj-chained" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kChainedTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 50 · Nonconvex Smooth · Coupled Chain</span>
        </div>
        <div id="home-obj-sparse" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kSparseTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 64 · Convex Composite · Exact ℓ₁ Prox</span>
        </div>
        <div id="home-obj-simplex" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kSimplexTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 64 · Convex Constrained · Simplex Projection</span>
        </div>
        <div id="home-obj-nuc" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kNucTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">8×8 (64D) · Spectral Composite · Exact SVD Prox</span>
        </div>
        <div id="home-obj-group" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kGroupTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 64 · Convex Composite · Block ℓ₂,₁ Prox</span>
        </div>
        <div id="home-obj-logreg" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kLogRegTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 64 · Convex Composite · Logistic + ℓ₁ Prox</span>
        </div>
        <div id="home-obj-spec" class="hidden flex-wrap items-center justify-between gap-2">
          <span set:html={kSpecTitle} />
          <span class="font-mono text-[11px] text-[var(--text-muted)]">d = 100 · Strongly Convex · Dense Rotated QΛQᵀ</span>
        </div>
      </div>
    </div>

    <!-- Setup / Data Row -->
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-[var(--border)]/60 pt-2">
      <span class="mr-1 min-w-[4.75rem] text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">
        Setup
      </span>
      <div class="min-w-0 flex-1 text-xs leading-relaxed text-[var(--text-muted)]">
        <div id="home-note-rosen" set:html={noteRosen} />
        <div id="home-note-quad" class="hidden" set:html={noteQuad} />
        <div id="home-note-himm" class="hidden" set:html={noteHimm} />
        <div id="home-note-lasso" class="hidden" set:html={noteLasso} />
        <div id="home-note-box" class="hidden" set:html={noteBox} />
        <div id="home-note-chained" class="hidden" set:html={noteChained} />
        <div id="home-note-sparse" class="hidden" set:html={noteSparse} />
        <div id="home-note-simplex" class="hidden" set:html={noteSimplex} />
        <div id="home-note-nuc" class="hidden" set:html={noteNuc} />
        <div id="home-note-group" class="hidden" set:html={noteGroup} />
        <div id="home-note-logreg" class="hidden" set:html={noteLogReg} />
        <div id="home-note-spec" class="hidden" set:html={noteSpec} />
      </div>
    </div>
  </div>

  <!-- Row 2: Control Deck (Sliders + Metric + Playback) -->
  <div class="grid gap-4 border-b border-[var(--border)] px-5 py-3.5 lg:grid-cols-[1fr_1fr_auto_auto] lg:items-end">
    <label class="flex flex-col gap-1.5 text-xs">
      <div class="flex items-center justify-between">
        <span id="home-param-label-rosen" class="font-medium text-[var(--text)]">
          Valley steepness <span set:html={kParamRosen} />
        </span>
        <span id="home-param-label-quad" class="hidden font-medium text-[var(--text)]">
          Condition number <span set:html={kParamQuad} />
        </span>
        <span id="home-param-label-himm" class="hidden font-medium text-[var(--text)]">
          Start angle <span set:html={kParamHimm} /> (°)
        </span>
        <span id="home-param-label-lasso" class="hidden font-medium text-[var(--text)]">
          Sparsity weight <span set:html={kParamL1} />
        </span>
        <span id="home-param-label-simplex" class="hidden font-medium text-[var(--text)]">
          Ridge regularization <span set:html={kParamSimplex} />
        </span>
        <span id="home-param-label-box" class="hidden font-medium text-[var(--text)]">
          Negative curvature <span set:html={kParamBox} />
        </span>
        <span id="home-param-val" class="font-mono font-semibold text-[var(--accent)]">100</span>
      </div>
      <input
        id="home-param-slider"
        type="range"
        min="15"
        max="180"
        value="100"
        step="5"
        class="accent-[var(--accent)]"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-xs">
      <div class="flex items-center justify-between">
        <span class="font-medium text-[var(--text)]">
          Iterations (<span set:html={kIterK} />)
        </span>
        <span id="home-iter-val" class="font-mono font-semibold text-[var(--accent)]">10000</span>
      </div>
      <input
        id="home-iter-slider"
        type="range"
        min="0"
        max="14000"
        value="10000"
        step="100"
        class="accent-[var(--accent)]"
      />
    </label>

    <!-- Metric Selector -->
    <div class="flex flex-col gap-1 text-xs">
      <span class="font-medium text-[var(--text-muted)]">Y-Axis Metric</span>
      <div class="inline-flex w-fit rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] p-0.5 text-[11px] font-medium">
        <button
          type="button"
          data-home-metric="obj"
          class="home-metric-btn rounded-md bg-[var(--surface)] px-2.5 py-1 text-[var(--text)] shadow-xs"
        >
          <span set:html={kObjMetric} />
        </button>
        <button
          type="button"
          data-home-metric="grad"
          class="home-metric-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          <span set:html={kGradMetric} />
        </button>
        <button
          type="button"
          data-home-metric="dist"
          class="home-metric-btn rounded-md px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          <span set:html={kDistMetric} />
        </button>
      </div>
    </div>

    <!-- Playback Controls -->
    <div class="flex flex-col gap-1 text-xs">
      <span class="font-medium text-[var(--text-muted)]">Animation</span>
      <div class="flex items-center gap-1.5">
        <label
          class="inline-flex items-center gap-1 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] px-2 py-1 text-[11px] text-[var(--text-muted)]"
          title="Iterations added per animation step (and slider step)"
        >
          <span>Δk</span>
          <input
            id="home-anim-step"
            type="number"
            min="1"
            max="2000"
            value="100"
            class="w-14 rounded border border-[var(--border)] bg-[var(--surface)] px-1 py-0.5 text-right font-mono text-[11px] font-semibold text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
        </label>
        <label
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] px-2 py-1 text-[11px] text-[var(--text-muted)]"
          title="Animation speed (steps per second)"
        >
          <span id="home-anim-fps-val" class="min-w-[2.4rem] font-mono text-[11px] font-semibold text-[var(--accent)]">20/s</span>
          <input
            id="home-anim-fps"
            type="range"
            min="1"
            max="60"
            value="20"
            step="1"
            class="w-16 accent-[var(--accent)]"
          />
        </label>
        <button
          id="home-demo-reset"
          type="button"
          title="Reset iterations to 0"
