---
import { Code } from 'astro:components';

interface Props {
  title: string;
  order: number;
  software_url: string;
  repo_url?: string;
  language?: string;
  role?: string;
  tags?: string[];
  description: string;
  snippet?: string;
}

const {
  title,
  order,
  software_url,
  repo_url,
  language,
  role,
  tags = [],
  description,
  snippet,
} = Astro.props;

const langLower = (language ?? '').toLowerCase();
const codeLang = langLower.includes('python')
  ? 'python'
  : langLower.includes('julia')
    ? 'julia'
    : langLower.includes('c++') || langLower.includes('cpp')
      ? 'cpp'
      : langLower.includes('matlab')
        ? 'matlab'
        : 'text';

// Convert basic **bold** and `code` in description safely
const formattedDesc = description
  .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-[var(--text)]">$1</strong>')
  .replace(/`([^`]+)`/g, '<code class="rounded bg-[var(--surface-subtle)] px-1.5 py-0.5 font-mono text-xs text-[var(--text)]">$1</code>');
---

<article class="card card-hover p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <span
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[var(--accent-soft)] font-mono text-xs font-semibold text-[var(--accent)]"
      >
        0{order}
      </span>
      <div>
        <h2 class="text-lg font-semibold tracking-tight text-[var(--text)]">
          <a
            href={software_url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--accent)]"
          >
            {title}
          </a>
        </h2>
        <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
          {language && <span class="font-mono">{language}</span>}
          {language && role && <span>·</span>}
          {role && <span>{role}</span>}
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={software_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg bg-[var(--accent)] px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-[var(--accent-hover)]"
      >
        Docs / Site
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </a>
      {
        repo_url && (
          <a
            href={repo_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] px-3 py-1.5 text-xs font-medium text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>

  <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-[var(--text-muted)]" set:html={formattedDesc} />

  {
    snippet && (
      <details class="mt-4 rounded-xl border border-[var(--border)] bg-[var(--surface-subtle)]/70">
        <summary class="cursor-pointer select-none px-4 py-2.5 text-xs font-medium text-[var(--text)] hover:text-[var(--accent)]">
          Quickstart example ({title})
        </summary>
        <div class="overflow-x-auto border-t border-[var(--border)]">
          <Code
            code={snippet}
            lang={codeLang}
            themes={{ light: 'github-light', dark: 'github-dark' }}
            class="rounded-b-xl p-4 font-mono text-xs leading-relaxed"
          />
        </div>
      </details>
    )
  }

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="rounded-full border border-[var(--border)] bg-[var(--surface-subtle)] px-2.5 py-0.5 text-[11px] font-medium text-[var(--text-muted)]">
            {t}
          </span>
        ))}
      </div>
    )
  }
</article>
