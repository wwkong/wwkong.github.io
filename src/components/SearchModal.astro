---
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 px-4 pt-20 backdrop-blur-xs"
  role="dialog"
  aria-modal="true"
  aria-label="Search site"
>
  <div
    class="w-full max-w-xl overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-2xl"
  >
    <div class="flex items-center gap-3 border-b border-[var(--border)] px-4 py-3">
      <svg
        class="h-4 w-4 shrink-0 text-[var(--text-muted)]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-modal-input"
        type="text"
        placeholder="Search blog posts, publications, software, course notes..."
        autocomplete="off"
        class="w-full bg-transparent text-sm text-[var(--text)] placeholder-[var(--text-muted)] focus:outline-none"
      />
      <button
        id="search-close-btn"
        type="button"
        class="rounded border border-[var(--border)] px-1.5 py-0.5 font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text)]"
      >
        ESC
      </button>
    </div>

    <ul
      id="search-modal-results"
      class="max-h-[60vh] divide-y divide-[var(--border)] overflow-y-auto p-2 text-sm"
    >
      <li class="px-3 py-6 text-center text-xs text-[var(--text-muted)]">
        Start typing to search across the site...
      </li>
    </ul>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('search-modal');
    const openBtn = document.getElementById('search-open-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const input = document.getElementById('search-modal-input');
    const resultsEl = document.getElementById('search-modal-results');
    let indexCache = null;

    async function loadIndex() {
      if (indexCache) return indexCache;
      try {
        const res = await fetch('/search-index.json');
        indexCache = await res.json();
      } catch {
        indexCache = [];
      }
      return indexCache;
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderResults(items, query) {
      if (!resultsEl) return;
      if (!query.trim()) {
        resultsEl.innerHTML =
          '<li class="px-3 py-6 text-center text-xs text-[var(--text-muted)]">Start typing to search blog posts, publications, software, and notes...</li>';
        return;
      }
      if (!items.length) {
        resultsEl.innerHTML =
          '<li class="px-3 py-6 text-center text-xs text-[var(--text-muted)]">No matches found for "' +
          escapeHtml(query) +
          '".</li>';
        return;
      }
      resultsEl.innerHTML = items
        .slice(0, 15)
        .map(
          (item) => `
          <li>
            <a href="${escapeHtml(item.url)}" class="flex flex-col gap-0.5 rounded-lg px-3 py-2.5 transition-colors hover:bg-[var(--surface-subtle)]">
              <div class="flex items-center justify-between gap-2">
                <span class="font-medium text-[var(--text)]">${escapeHtml(item.title)}</span>
                <span class="shrink-0 rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[10px] font-medium text-[var(--accent)]">${escapeHtml(item.kind)}</span>
              </div>
              ${item.meta ? `<span class="line-clamp-1 text-xs text-[var(--text-muted)]">${escapeHtml(item.meta)}</span>` : ''}
            </a>
          </li>`
        )
        .join('');
    }

    async function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      input?.focus();
      await loadIndex();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) openModal();
        else closeModal();
      } else if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    input?.addEventListener('input', async () => {
      const q = input.value.trim().toLowerCase();
      const idx = await loadIndex();
      if (!q) {
        renderResults([], '');
        return;
      }
      const tokens = q.split(/\s+/).filter(Boolean);
      const hits = idx.filter((entry) => {
        const hay = `${entry.title} ${entry.meta || ''} ${entry.keywords || ''}`.toLowerCase();
        return tokens.every((t) => hay.includes(t));
      });
      renderResults(hits, q);
    });
  })();
</script>
