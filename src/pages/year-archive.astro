---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => {
  const diff = b.data.date.getTime() - a.data.date.getTime();
  if (diff !== 0) return diff;
  return (b.data.seriesOrder ?? 0) - (a.data.seriesOrder ?? 0);
});

const years = Array.from(new Set(posts.map((p) => p.data.date.getUTCFullYear()))).sort(
  (a, b) => b - a
);
const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title="Blog Posts"
  description="Mathematical and algorithmic deep dives on abstract duality, acceleration in optimization, Lipschitz smoothness, and multivariate derivatives."
>
  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--text)]">Blog Posts</h1>
    <p class="mt-2 text-sm text-[var(--text-muted)]">
      Expository notes and proofs on optimization theory, convex analysis, and multivariate calculus.
    </p>
  </header>

  <div class="mb-8 flex flex-wrap gap-2">
    <button
      type="button"
      data-tag="all"
      class="blog-tag-btn rounded-full bg-[var(--accent)] px-3 py-1 text-xs font-medium text-white transition-colors"
    >
      All ({posts.length})
    </button>
    {
      allTags.map((tag) => (
        <button
          type="button"
          data-tag={tag}
          class="blog-tag-btn rounded-full border border-[var(--border)] bg-[var(--surface-subtle)] px-3 py-1 text-xs font-medium text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          #{tag}
        </button>
      ))
    }
  </div>

  <div class="space-y-10">
    {
      years.map((year) => {
        const yearPosts = posts.filter((p) => p.data.date.getUTCFullYear() === year);
        return (
          <section class="blog-year-group">
            <div class="mb-4 flex items-center gap-3">
              <h2 class="text-xl font-bold tracking-tight text-[var(--text)]">{year}</h2>
              <div class="h-px flex-1 bg-[var(--border)]" />
            </div>

            <div class="grid gap-4">
              {yearPosts.map((post) => {
                const dateStr = post.data.date.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  timeZone: 'UTC',
                });
                return (
                  <a
                    href={`/${post.data.slug}/`}
                    class="blog-post-card card card-hover block p-5"
                    data-tags={post.data.tags.join('|')}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-[var(--text-muted)]">
                      <time datetime={post.data.date.toISOString()}>{dateStr}</time>
                      {post.data.difficulty && (
                        <span class="rounded-full bg-[var(--accent-soft)] px-2.5 py-0.5 font-medium text-[var(--accent)]">
                          {post.data.difficulty}
                        </span>
                      )}
                    </div>
                    <h3 class="mt-2 text-lg font-semibold text-[var(--text)]">
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">
                        {post.data.description}
                      </p>
                    )}
                    {post.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {post.data.tags.map((t) => (
                          <span class="rounded-full bg-[var(--surface-subtle)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]">
                            #{t}
                          </span>
                        ))}
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const btns = Array.from(document.querySelectorAll('.blog-tag-btn'));
    const cards = Array.from(document.querySelectorAll('.blog-post-card'));
    const groups = Array.from(document.querySelectorAll('.blog-year-group'));

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag || 'all';
        btns.forEach((b) => {
          const active = b.dataset.tag === tag;
          b.className = active
            ? 'blog-tag-btn rounded-full bg-[var(--accent)] px-3 py-1 text-xs font-medium text-white transition-colors'
            : 'blog-tag-btn rounded-full border border-[var(--border)] bg-[var(--surface-subtle)] px-3 py-1 text-xs font-medium text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]';
        });
        cards.forEach((c) => {
          const tags = (c.dataset.tags || '').split('|');
          c.classList.toggle('hidden', tag !== 'all' && !tags.includes(tag));
        });
        groups.forEach((g) => {
          g.classList.toggle('hidden', g.querySelector('.blog-post-card:not(.hidden)') === null);
        });
      });
    });
  })();
</script>
