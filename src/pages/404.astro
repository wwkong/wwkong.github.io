---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="py-20 text-center">
    <p class="font-mono text-sm font-semibold text-[var(--accent)]">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text)]">Page not found</h1>
    <p class="mt-3 text-sm text-[var(--text-muted)]">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
    >
      ← Back to Homepage
    </a>
  </div>
</BaseLayout>
