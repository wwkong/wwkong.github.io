---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProxaxHomepageDemo from '../components/demos/ProxaxHomepageDemo.astro';
import { SITE, RESEARCH_PILLARS, RECENT_NEWS } from '../data/site';
---

<BaseLayout title={SITE.title} description={SITE.description} includeKatex={true} wide={true}>
  <div class="space-y-6">
    <!-- Top Row: 3-Column Bento Grid (Bio | Recent News | Research Pillars) -->
    <section class="grid gap-5 lg:grid-cols-2 xl:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <!-- Column 1: Bio Card -->
      <div class="card flex flex-col justify-between p-5 lg:col-span-2 xl:col-span-1">
        <div>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
            <img
              src={SITE.avatar}
              alt={SITE.name}
              width="88"
              height="88"
              class="h-22 w-22 shrink-0 rounded-2xl border border-[var(--border)] object-cover shadow-xs"
            />
            <div class="min-w-0">
              <h1 class="text-2xl font-bold tracking-tight text-[var(--text)]">
                {SITE.fullName}
              </h1>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {
                  SITE.socials.map((s) => (
                    <a
                      href={s.href}
                      target={s.href.startsWith('http') ? '_blank' : undefined}
                      rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] px-2.5 py-1 text-xs font-medium text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
                    >
                      {s.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="mt-4 space-y-2.5 text-sm leading-relaxed text-[var(--text-muted)]">
            <p>
              Hi! I'm <strong class="font-semibold text-[var(--text)]">William Kong</strong>, a Research Software
              Engineer at{' '}
              <a
                href="https://research.google/locations/new-york/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Google Research (NYC)</a
              >{' '}
              in{' '}
              <a
                href="https://research.google/teams/athena/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Athena</a
              >. Here you'll find my{' '}
              <a href="/publications/" class="font-medium text-[var(--accent)] underline underline-offset-2">publications</a>,
              open-source{' '}
              <a href="/software/" class="font-medium text-[var(--accent)] underline underline-offset-2">software</a>,
              mathematical{' '}
              <a href="/year-archive/" class="font-medium text-[var(--accent)] underline underline-offset-2">blog posts</a>,
              and{' '}
              <a href="/notes/" class="font-medium text-[var(--accent)] underline underline-offset-2">course notes</a>.
            </p>
            <p>
              Previously, I was a postdoc in the{' '}
              <a
                href="https://www.ornl.gov/division/csmd"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >CSMD</a
              >{' '}
              at{' '}
              <a
                href="https://www.ornl.gov/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Oak Ridge National Labs</a
              >{' '}
              under{' '}
              <a
                href="https://www.ornl.gov/staff-profile/miroslav-k-stoyanov"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Miroslav Stoyanov</a
              >, a Research Intern at Google Research (MTV), and a Senior Risk Analyst at{' '}
              <a
                href="https://www.td.com/us/en/personal-banking"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >TD Bank</a
              >.
            </p>
            <p>
              I received my Ph.D. in Operations Research from{' '}
              <a
                href="https://www.gatech.edu/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Georgia Tech</a
              >{' '}
              under{' '}
              <a
                href="https://sites.gatech.edu/renato-monteiro/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >Renato D. C. Monteiro</a
              >, along with an M.Sc. in Computational Science &amp; Engineering (Georgia Tech) and a B.Math. from the{' '}
              <a
                href="https://uwaterloo.ca/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--accent)] underline underline-offset-2"
                >University of Waterloo</a
              >.
            </p>
          </div>
        </div>
      </div>

      <!-- Column 2: Recent News Card -->
      <div class="card flex flex-col overflow-hidden">
        <div class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--surface-subtle)]/70 px-5 py-3.5">
          <h2 class="text-sm font-bold tracking-tight text-[var(--text)]">Recent News</h2>
          <a href="/year-archive/" class="text-xs font-medium text-[var(--accent)] hover:underline">
            Blog →
          </a>
        </div>
        <ul class="flex-1 divide-y divide-[var(--border)]">
          {
            RECENT_NEWS.map((item) => (
              <li class="flex items-baseline gap-3 px-5 py-2.5 text-xs leading-relaxed">
                <span class="w-16 shrink-0 font-mono text-[11px] font-semibold text-[var(--accent)]">
                  {item.date}
                </span>
                <a
                  href={item.href}
                  class="text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Research Pillars Card -->
      <div class="card flex flex-col overflow-hidden">
        <div class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--surface-subtle)]/70 px-5 py-3.5">
          <h2 class="text-sm font-bold tracking-tight text-[var(--text)]">Research Pillars</h2>
          <a href="/publications/" class="text-xs font-medium text-[var(--accent)] hover:underline">
            27 papers →
          </a>
        </div>
        <div class="flex-1 divide-y divide-[var(--border)]">
          {
            RESEARCH_PILLARS.map((pillar) => (
              <div class="px-5 py-3">
                <h3 class="text-xs font-semibold text-[var(--text)]">{pillar.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-[var(--text-muted)]">{pillar.summary}</p>
                <div class="mt-2 flex flex-wrap gap-3">
                  {pillar.links.map((l) => (
                    <a
                      href={l.href}
                      target={l.href.startsWith('http') ? '_blank' : undefined}
                      rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="text-[11px] font-semibold text-[var(--accent)] hover:underline"
                    >
                      {l.label} →
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Bottom Row: Full-Width Interactive Optimization Sandbox -->
    <section>
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">Interactive Demo</h2>
        <a href="/software/" class="text-xs font-medium text-[var(--accent)] hover:underline">
          Explore Proxax &amp; software →
        </a>
      </div>
      <ProxaxHomepageDemo />
    </section>
  </div>
</BaseLayout>
