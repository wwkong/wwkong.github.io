---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume" description="Resume of William Kong, Research Software Engineer at Google Research.">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--text)]">Resume</h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        View below or download the latest PDF directly.
      </p>
    </div>

    <a
      href="/files/resume_williamkong.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-xl bg-[var(--accent)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" x2="12" y1="15" y2="3" />
      </svg>
      Download PDF
    </a>
  </header>

  <!-- Scannable Experience & Education Summary -->
  <section class="mb-6 grid gap-5 md:grid-cols-2">
    <div class="card p-5">
      <h2 class="mb-4 text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">Experience</h2>
      <ol class="space-y-4 border-l border-[var(--border)] pl-4">
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2.5 w-2.5 rounded-full border-2 border-[var(--surface)] bg-[var(--accent)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">Research Software Engineer</div>
          <div class="text-xs text-[var(--text-muted)]">Google Research (NYC) · Athena Team</div>
          <p class="mt-1 text-xs leading-relaxed text-[var(--text-muted)]">
            Nonconvex composite optimization (Proxax), scalable differentially private ML (JAX-Privacy), and synthetic data &amp; LLM training.
          </p>
        </li>
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2 w-2 rounded-full bg-[var(--border)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">Postdoctoral Research Associate</div>
          <div class="text-xs text-[var(--text-muted)]">Oak Ridge National Laboratory · CSMD</div>
          <p class="mt-1 text-xs leading-relaxed text-[var(--text-muted)]">
            Sparse-grid approximation and scientific optimization (TASMANIAN) under Miroslav Stoyanov.
          </p>
        </li>
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2 w-2 rounded-full bg-[var(--border)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">Research Intern</div>
          <div class="text-xs text-[var(--text-muted)]">Google Research (Mountain View)</div>
        </li>
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2 w-2 rounded-full bg-[var(--border)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">Senior Risk Analyst</div>
          <div class="text-xs text-[var(--text-muted)]">TD Bank</div>
        </li>
      </ol>
    </div>

    <div class="card p-5">
      <h2 class="mb-4 text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">Education</h2>
      <ol class="space-y-4 border-l border-[var(--border)] pl-4">
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2.5 w-2.5 rounded-full border-2 border-[var(--surface)] bg-[var(--accent)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">Ph.D. in Operations Research</div>
          <div class="text-xs text-[var(--text-muted)]">Georgia Institute of Technology</div>
          <p class="mt-1 text-xs leading-relaxed text-[var(--text-muted)]">
            Advisor: Renato D. C. Monteiro · Accelerated proximal &amp; penalty methods for nonconvex composite optimization.
          </p>
        </li>
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2 w-2 rounded-full bg-[var(--border)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">M.Sc. in Computational Science &amp; Engineering</div>
          <div class="text-xs text-[var(--text-muted)]">Georgia Institute of Technology</div>
        </li>
        <li class="relative">
          <span class="absolute top-1.5 -left-[1.32rem] h-2 w-2 rounded-full bg-[var(--border)]"></span>
          <div class="text-sm font-semibold text-[var(--text)]">B.Math. in Mathematical Optimization &amp; Actuarial Science</div>
          <div class="text-xs text-[var(--text-muted)]">University of Waterloo</div>
        </li>
      </ol>
    </div>
  </section>

  <div class="card overflow-hidden">
    <object
      data="/files/resume_williamkong.pdf"
      type="application/pdf"
      class="h-[80vh] min-h-[640px] w-full"
    >
      <div class="p-8 text-center text-sm text-[var(--text-muted)]">
        <p>Your browser does not support inline PDF viewing.</p>
        <a
          href="/files/resume_williamkong.pdf"
          class="mt-3 inline-block font-semibold text-[var(--accent)] underline"
        >
          Click here to download the resume PDF
        </a>
      </div>
    </object>
  </div>
</BaseLayout>
